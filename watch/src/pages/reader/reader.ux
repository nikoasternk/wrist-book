<template>
  <div class="reader-page">
    <div class="top-safe-zone" style="height: {{paddingY}}px;">
      <text class="status-txt">{{clockTime}}</text>
      <text class="status-txt">{{batteryLevel}}%</text>
    </div>

    <scroll
      id="scrollViewport"
      class="scroll-area"
      style="height: {{viewportHeight}}px;"
      scroll-y="true"
      @scroll="onScrollMove"
      @scrollbottom="onScrollReachBottom">

      <div for="{{segments}}" class="segment-wrapper">
        <div
          if="{{$item.unloaded}}"
          class="placeholder-box"
          style="height: {{$item.height}}px;">
        </div>
        <text
          else
          class="book-text"
          style="font-size: {{fontSize}}px; line-height: {{lineHeight}}px; color: {{textColor}};">{{$item.text}}</text>
      </div>
    </scroll>

    <div class="bottom-safe-zone" style="height: {{paddingY}}px;">
      <text class="progress-txt">{{progressPercent}}%</text>
    </div>
  </div>
</template>

<script>
import battery from '@system.battery'
import brightness from '@system.brightness'
import storage from '@system.storage'
import file from '@system.file'
import { getStrings, applySafeBrightness } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    clockTime: '00:00',
    batteryLevel: 100,
    stayAwake: true,
    brightnessPct: 100,
    textColor: '#FFFFFF',
    fontSize: 30,
    lineHeight: 40,
    paddingY: 36,
    viewportHeight: 448,
    windowChars: 1500,
    chunkSize: 500,
    totalChars: 0,
    bookUri: '',
    bookName: '',
    segments: [],
    nextSegmentId: 1,
    lastMeasuredTotalHeight: 0,
    currentScrollY: 0,
    isLoadingChunk: false,
    progressPercent: 0,
    clockTimer: null,
    saveTimer: null
  },

  protected: {
    uri: '',
    name: ''
  },

  onInit() {
    this.bookUri = this.uri;
    this.bookName = this.name;
    this.updateClock();
    this.clockTimer = setInterval(() => {
      this.updateClock();
      this.updateBattery();
    }, 20000);
    this.updateBattery();
  },

  onShow() {
    this.loadSettingsAndStart();
  },

  onHide() {
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  onDestroy() {
    if (this.clockTimer) clearInterval(this.clockTimer);
    if (this.saveTimer) clearTimeout(this.saveTimer);
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  loadSettingsAndStart() {
    storage.get({
      key: 'WRISTBOOK_CONFIG_V3',
      success: (data) => {
        let lang = 'auto';
        if (data) {
          const cfg = JSON.parse(data);
          this.fontSize = cfg.fontSize || 30;
          this.lineHeight = Math.floor(this.fontSize * 1.35);
          this.windowChars = Math.max(600, cfg.windowChars || 1500);
          this.chunkSize = Math.max(300, Math.floor(this.windowChars / 3));
          this.paddingY = Math.max(24, Math.min(100, cfg.paddingY !== undefined ? cfg.paddingY : 36));
          this.stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          this.brightnessPct = cfg.brightnessPct || 100;
          lang = cfg.language || 'auto';
        }
        this.viewportHeight = Math.max(240, 520 - (this.paddingY * 2));
        this.strings = getStrings(lang);
        const br = applySafeBrightness(this.brightnessPct);
        this.textColor = br.textColor;
        brightness.setMode({ mode: 0 });
        brightness.setValue({ value: br.hwValue });
        brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });

        if (this.segments.length === 0) {
          this.initFileMetrics();
        }
      },
      fail: () => {
        this.viewportHeight = 448;
        this.strings = getStrings('auto');
        brightness.setKeepScreenOn({ keepScreenOn: true });
        if (this.segments.length === 0) {
          this.initFileMetrics();
        }
      }
    });
  },

  initFileMetrics() {
    file.get({
      uri: this.bookUri,
      success: (meta) => {
        this.totalChars = Math.floor(meta.length / 2);
        this.restoreStartOffset();
      },
      fail: () => {
        this.segments = [{
          id: 1,
          startChar: 0,
          charLen: 0,
          text: this.strings.fileError,
          height: 200,
          unloaded: false
        }];
      }
    });
  },

  restoreStartOffset() {
    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        const startOffset = (map[this.bookName] && map[this.bookName].charOffset) ? map[this.bookName].charOffset : 0;
        this.startStreamFrom(startOffset);
      },
      fail: () => {
        this.startStreamFrom(0);
      }
    });
  },

  startStreamFrom(initialOffset) {
    if (this.totalChars <= 0) {
      this.segments = [{
        id: 1,
        startChar: 0,
        charLen: 0,
        text: this.strings.emptyFile,
        height: 200,
        unloaded: false
      }];
      return;
    }

    const safeStart = Math.max(0, Math.min(initialOffset, Math.max(0, this.totalChars - this.chunkSize)));
    this.segments = [];
    this.lastMeasuredTotalHeight = 0;
    this.appendNextChunk(safeStart, () => {
      const lastSeg = this.segments[this.segments.length - 1];
      if (lastSeg && (lastSeg.startChar + lastSeg.charLen) < this.totalChars) {
        this.appendNextChunk(lastSeg.startChar + lastSeg.charLen);
      }
    });
  },

  appendNextChunk(startChar, onDone) {
    if (this.isLoadingChunk || startChar >= this.totalChars) {
      if (onDone) onDone();
      return;
    }

    this.isLoadingChunk = true;
    const charsToRead = Math.min(this.chunkSize, this.totalChars - startChar);

    file.readArrayBuffer({
      uri: this.bookUri,
      position: startChar * 2,
      length: charsToRead * 2,
      success: (res) => {
        let str = '';
        const buf = res.buffer;
        for (let i = 0; i + 1 < buf.length; i += 2) {
          str += String.fromCharCode((buf[i + 1] << 8) | buf[i]);
        }

        const estLines = Math.max(4, Math.ceil(charsToRead / 11));
        const fallbackHeight = estLines * this.lineHeight;

        const segId = this.nextSegmentId++;
        this.segments.push({
          id: segId,
          startChar: startChar,
          charLen: charsToRead,
          text: str,
          height: fallbackHeight,
          unloaded: false
        });

        this.updateProgressMetric(startChar + charsToRead);

        setTimeout(() => {
          this.measureAndPrune(segId, fallbackHeight, () => {
            this.isLoadingChunk = false;
            if (onDone) onDone();
          });
        }, 60);
      },
      fail: () => {
        this.isLoadingChunk = false;
        if (onDone) onDone();
      }
    });
  },

  measureAndPrune(newSegId, fallbackHeight, callback) {
    const scroller = this.$element('scrollViewport');
    if (!scroller || !scroller.getScrollRect) {
      this.pruneOldSegments();
      if (callback) callback();
      return;
    }

    scroller.getScrollRect({
      success: (rect) => {
        if (rect && rect.height > this.lastMeasuredTotalHeight) {
          const deltaHeight = rect.height - this.lastMeasuredTotalHeight;
          this.lastMeasuredTotalHeight = rect.height;
          for (let i = 0; i < this.segments.length; i++) {
            if (this.segments[i].id === newSegId) {
              this.segments[i].height = deltaHeight > 20 ? deltaHeight : fallbackHeight;
              break;
            }
          }
        }
        this.pruneOldSegments();
        if (callback) callback();
      },
      fail: () => {
        this.pruneOldSegments();
        if (callback) callback();
      }
    });
  },

  pruneOldSegments() {
    let activeChars = 0;
    let activeCount = 0;

    for (let i = this.segments.length - 1; i >= 0; i--) {
      const seg = this.segments[i];
      if (!seg.unloaded) {
        activeChars += seg.charLen;
        activeCount++;
        if (activeCount > 2 && activeChars > this.windowChars) {
          seg.unloaded = true;
          seg.text = '';
        }
      }
    }
  },

  reloadSegmentAt(index) {
    if (this.isLoadingChunk || index < 0 || index >= this.segments.length) return;
    const seg = this.segments[index];
    if (!seg.unloaded) return;

    this.isLoadingChunk = true;
    file.readArrayBuffer({
      uri: this.bookUri,
      position: seg.startChar * 2,
      length: seg.charLen * 2,
      success: (res) => {
        let str = '';
        const buf = res.buffer;
        for (let i = 0; i + 1 < buf.length; i += 2) {
          str += String.fromCharCode((buf[i + 1] << 8) | buf[i]);
        }
        seg.text = str;
        seg.unloaded = false;
        this.isLoadingChunk = false;
      },
      fail: () => {
        this.isLoadingChunk = false;
      }
    });
  },

  onScrollMove(evt) {
    if (!evt || evt.scrollY === undefined) return;
    const scrollY = Math.max(0, evt.scrollY);
    this.currentScrollY = scrollY;

    let accHeight = 0;
    let currentVisibleChar = 0;

    for (let i = 0; i < this.segments.length; i++) {
      const seg = this.segments[i];
      const segBottom = accHeight + seg.height;

      if (seg.unloaded && scrollY <= segBottom + 260 && scrollY >= accHeight - 260) {
        this.reloadSegmentAt(i);
      }

      if (scrollY >= accHeight && scrollY <= segBottom) {
        const ratio = seg.height > 0 ? Math.min(1, (scrollY - accHeight) / seg.height) : 0;
        currentVisibleChar = seg.startChar + Math.floor(seg.charLen * ratio);
      }
      accHeight = segBottom;
    }

    if (this.lastMeasuredTotalHeight > 0 && (scrollY + this.viewportHeight + 320) >= this.lastMeasuredTotalHeight) {
      this.triggerNextChunkLoad();
    }

    if (currentVisibleChar > 0) {
      this.updateProgressMetric(currentVisibleChar);
      this.scheduleProgressSave(currentVisibleChar);
    }
  },

  onScrollReachBottom() {
    this.triggerNextChunkLoad();
  },

  triggerNextChunkLoad() {
    if (this.isLoadingChunk || this.segments.length === 0) return;
    const lastSeg = this.segments[this.segments.length - 1];
    const nextStart = lastSeg.startChar + lastSeg.charLen;
    if (nextStart < this.totalChars) {
      this.appendNextChunk(nextStart);
    }
  },

  updateProgressMetric(charPos) {
    if (this.totalChars > 0) {
      this.progressPercent = Math.min(100, Math.max(1, Math.floor((charPos / this.totalChars) * 100)));
    }
  },

  scheduleProgressSave(charPos) {
    this.lastActiveCharOffset = charPos;
    if (this.saveTimer) return;
    this.saveTimer = setTimeout(() => {
      this.saveTimer = null;
      this.flushProgressNow();
    }, 2500);
  },

  flushProgressNow() {
    const offsetToSave = this.lastActiveCharOffset;
    if (offsetToSave === undefined || !this.bookName) return;

    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      },
      fail: () => {
        const map = {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      }
    });
  },

  updateClock() {
    const d = new Date();
    this.clockTime = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  },

  updateBattery() {
    battery.getStatus({
      success: (res) => {
        this.batteryLevel = Math.floor(res.level * 100);
      }
    });
  }
}
</script>

<style>
.reader-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.top-safe-zone {
  width: 212px;
  padding: 0 22px 4px 22px;
  background-color: #000000;
  justify-content: space-between;
  align-items: flex-end;
  flex-shrink: 0;
}

.status-txt {
  color: #888888;
  font-size: 20px;
  font-weight: bold;
}

.scroll-area {
  width: 212px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.segment-wrapper {
  width: 196px;
  flex-direction: column;
  flex-shrink: 0;
}

.placeholder-box {
  width: 196px;
  flex-shrink: 0;
}

.book-text {
  width: 196px;
  flex-shrink: 0;
  font-weight: bold;
  text-align: left;
  lines: -1;
}

.bottom-safe-zone {
  width: 212px;
  padding-top: 4px;
  background-color: #000000;
  justify-content: center;
  align-items: flex-start;
  flex-shrink: 0;
}

.progress-txt {
  color: #666666;
  font-size: 18px;
  font-weight: bold;
}
</style>
