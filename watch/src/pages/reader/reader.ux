<template>
  <div class="reader-page">
    <scroll
      id="scrollViewport"
      class="scroll-area"
      scroll-y="true"
      @scroll="onScrollMove"
      @scrolltop="onScrollReachTop"
      @scrollbottom="onScrollReachBottom">

      <div class="edge-pad" style="height: {{paddingY}}px;"></div>

      <div for="{{segments}}" tid="id" class="segment-wrapper">
        <div
          if="{{$item.unloaded}}"
          class="placeholder-box"
          style="height: {{$item.height}}px;">
        </div>
        <text
          else
          class="book-text"
          style="font-size: {{fontSize}}px; line-height: {{lineHeight}}px;">{{$item.text}}</text>
      </div>

      <div class="edge-pad" style="height: {{paddingY}}px;"></div>
    </scroll>

    <div class="top-mask" style="height: {{paddingY}}px;">
      <text class="clock-txt">{{clockTime}}</text>
    </div>

    <div class="bottom-mask" style="height: {{paddingY}}px;"></div>
  </div>
</template>

<script>
import brightness from '@system.brightness'
import storage from '@system.storage'
import file from '@system.file'
import { getStrings, pctToHardwareBrightness } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    clockTime: '00:00',
    stayAwake: true,
    customBrightness: false,
    brightnessPct: 80,
    fontSize: 28,
    lineHeight: 38,
    paddingY: 36,
    windowChars: 2000,
    chunkSize: 300,
    totalChars: 0,
    bookUri: '',
    bookName: '',
    segments: [],
    nextUniqueId: 1,
    isBusy: false,
    lastKnownScrollHeight: 0,
    currentActiveIndex: 0,
    lastActiveCharOffset: 0,
    progressPercent: 0,
    clockTimer: null,
    saveTimer: null
  },

  protected: {
    uri: '',
    name: ''
  },

  onInit() {
    this.bookUri = this.uri;
    this.bookName = this.name;
    this.measuredHeights = {};
    this.updateClock();
    this.clockTimer = setInterval(() => {
      this.updateClock();
    }, 20000);
  },

  onShow() {
    this.loadSettingsAndStart();
  },

  onHide() {
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  onDestroy() {
    if (this.clockTimer) clearInterval(this.clockTimer);
    if (this.saveTimer) clearTimeout(this.saveTimer);
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  loadSettingsAndStart() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        let lang = 'auto';
        if (data) {
          const cfg = JSON.parse(data);
          this.fontSize = Math.max(8, Math.min(48, cfg.fontSize || 28));
          this.lineHeight = Math.max(10, Math.floor(this.fontSize * 1.35));
          this.windowChars = Math.max(1000, cfg.windowChars || 2000);
          this.chunkSize = 300;
          this.paddingY = Math.max(16, Math.min(120, cfg.paddingY !== undefined ? cfg.paddingY : 36));
          this.stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          this.customBrightness = cfg.customBrightness === true;
          this.brightnessPct = cfg.brightnessPct !== undefined ? cfg.brightnessPct : 80;
          lang = cfg.language || 'auto';
        }
        this.strings = getStrings(lang);
        if (this.customBrightness) {
          brightness.setMode({ mode: 0 });
          brightness.setValue({ value: pctToHardwareBrightness(this.brightnessPct) });
        }
        brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });

        if (this.segments.length === 0) {
          this.initFileMetrics();
        }
      },
      fail: () => {
        this.strings = getStrings('auto');
        brightness.setKeepScreenOn({ keepScreenOn: true });
        if (this.segments.length === 0) {
          this.initFileMetrics();
        }
      }
    });
  },

  initFileMetrics() {
    file.get({
      uri: this.bookUri,
      success: (meta) => {
        this.totalChars = Math.floor(meta.length / 2);
        this.restoreStartOffset();
      },
      fail: () => {
        this.segments = [{
          id: 1,
          startChar: 0,
          charLen: 0,
          text: this.strings.fileError,
          height: 200,
          unloaded: false
        }];
      }
    });
  },

  restoreStartOffset() {
    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        const startOffset = (map[this.bookName] && map[this.bookName].charOffset !== undefined)
          ? map[this.bookName].charOffset
          : 0;
        this.startReadingSession(startOffset);
      },
      fail: () => {
        this.startReadingSession(0);
      }
    });
  },

  decodeBufferFast(u8Buf) {
    if (!u8Buf || u8Buf.length < 2) return '';
    try {
      const u16 = new Uint16Array(u8Buf.buffer, u8Buf.byteOffset, u8Buf.byteLength >> 1);
      return String.fromCharCode.apply(null, u16);
    } catch (e) {
      const codes = [];
      for (let i = 0; i + 1 < u8Buf.length; i += 2) {
        codes.push((u8Buf[i + 1] << 8) | u8Buf[i]);
      }
      return String.fromCharCode.apply(null, codes);
    }
  },

  readCleanSlice(startChar, maxLen, callback) {
    if (startChar >= this.totalChars || maxLen <= 0) {
      callback(null, 0);
      return;
    }
    const readLen = Math.min(maxLen, this.totalChars - startChar);
    const isEnd = (startChar + readLen) >= this.totalChars;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: startChar * 2,
      length: readLen * 2,
      success: (res) => {
        let str = this.decodeBufferFast(res.buffer);
        if (!isEnd && str.length > 35) {
          let cut = -1;
          for (let j = str.length - 1; j >= str.length - 30; j--) {
            if (str[j] === ' ' || str[j] === '\n') {
              cut = j + 1;
              break;
            }
          }
          if (cut > 0) {
            str = str.substring(0, cut);
          }
        }
        if (!isEnd && str.length > 0 && str[str.length - 1] === '\n') {
          str = str.substring(0, str.length - 1);
        }
        callback(str, str.length);
      },
      fail: () => {
        callback(null, 0);
      }
    });
  },

  getScrollHeight(callback) {
    const scroller = this.$element('scrollViewport');
    if (!scroller || !scroller.getScrollRect) {
      callback(0);
      return;
    }
    scroller.getScrollRect({
      success: (rect) => {
        callback((rect && rect.height) ? rect.height : 0);
      },
      fail: () => {
        callback(0);
      }
    });
  },

  startReadingSession(savedOffset) {
    if (this.totalChars <= 0) {
      this.segments = [{
        id: 1,
        startChar: 0,
        charLen: 0,
        text: this.strings.emptyFile,
        height: 200,
        unloaded: false
      }];
      return;
    }

    this.isBusy = true;
    const clampedOffset = Math.max(0, Math.min(savedOffset, Math.max(0, this.totalChars - 1)));
    this.lastActiveCharOffset = clampedOffset;
    this.updateProgressMetric(clampedOffset);

    if (clampedOffset > 0) {
      const prevStart = Math.max(0, clampedOffset - this.chunkSize);
      const prevDesired = clampedOffset - prevStart;

      file.readArrayBuffer({
        uri: this.bookUri,
        position: prevStart * 2,
        length: prevDesired * 2,
        success: (res1) => {
          const prevText = this.decodeBufferFast(res1.buffer);
          const id1 = this.nextUniqueId++;
          this.segments = [{
            id: id1,
            startChar: prevStart,
            charLen: prevDesired,
            text: prevText,
            height: 300,
            unloaded: false
          }];

          setTimeout(() => {
            this.getScrollHeight((h1) => {
              const seg1RealHeight = Math.max(40, h1 - (this.paddingY * 2));
              this.measuredHeights[id1] = seg1RealHeight;

              this.readCleanSlice(clampedOffset, this.chunkSize * 2, (currText, currLen) => {
                const id2 = this.nextUniqueId++;
                this.segments.push({
                  id: id2,
                  startChar: clampedOffset,
                  charLen: currLen,
                  text: currText || '',
                  height: 300,
                  unloaded: false
                });
                this.currentActiveIndex = 1;

                setTimeout(() => {
                  this.getScrollHeight((h2) => {
                    const seg2RealHeight = Math.max(40, h2 - h1);
                    this.measuredHeights[id2] = seg2RealHeight;
                    this.lastKnownScrollHeight = h2;
                    try {
                      this.$element('scrollViewport').scrollTo({ top: seg1RealHeight, behavior: 'instant' });
                    } catch (e) {}
                    this.isBusy = false;
                  });
                }, 30);
              });
            });
          }, 30);
        },
        fail: () => {
          this.isBusy = false;
        }
      });
    } else {
      this.readCleanSlice(0, this.chunkSize * 2, (firstText, firstLen) => {
        const id1 = this.nextUniqueId++;
        this.segments = [{
          id: id1,
          startChar: 0,
          charLen: firstLen,
          text: firstText || '',
          height: 300,
          unloaded: false
        }];
        this.currentActiveIndex = 0;

        setTimeout(() => {
          this.getScrollHeight((h1) => {
            this.measuredHeights[id1] = Math.max(40, h1 - (this.paddingY * 2));
            this.lastKnownScrollHeight = h1;
            this.isBusy = false;
          });
        }, 30);
      });
    }
  },

  triggerNextChunkLoad() {
    if (this.isBusy || this.segments.length === 0) return;

    for (let i = Math.max(0, this.segments.length - 2); i < this.segments.length; i++) {
      if (this.segments[i].unloaded) {
        this.reloadUnloadedSegment(i);
        return;
      }
    }

    const lastSeg = this.segments[this.segments.length - 1];
    const nextStart = lastSeg.startChar + lastSeg.charLen;
    if (nextStart >= this.totalChars) return;

    this.isBusy = true;
    const heightBefore = this.lastKnownScrollHeight;

    this.readCleanSlice(nextStart, this.chunkSize, (str, actualLen) => {
      if (!str || actualLen <= 0) {
        this.isBusy = false;
        return;
      }

      const maxActiveCount = Math.max(4, Math.ceil(this.windowChars / this.chunkSize));
      const allowedRadius = Math.max(2, Math.floor(maxActiveCount / 2));
      const newCenterIdx = this.segments.length;

      for (let i = 0; i < this.segments.length; i++) {
        const seg = this.segments[i];
        if (!seg.unloaded && (newCenterIdx - i) > allowedRadius && this.measuredHeights[seg.id]) {
          seg.height = this.measuredHeights[seg.id];
          seg.unloaded = true;
          seg.text = '';
        }
      }

      const newId = this.nextUniqueId++;
      this.segments.push({
        id: newId,
        startChar: nextStart,
        charLen: actualLen,
        text: str,
        height: 300,
        unloaded: false
      });

      setTimeout(() => {
        this.getScrollHeight((heightAfter) => {
          if (heightAfter > heightBefore && heightBefore > 0) {
            this.measuredHeights[newId] = heightAfter - heightBefore;
          }
          if (heightAfter > 0) {
            this.lastKnownScrollHeight = heightAfter;
          }
          this.isBusy = false;
        });
      }, 25);
    });
  },

  onScrollReachBottom() {
    this.triggerNextChunkLoad();
  },

  onScrollReachTop() {
    if (this.isBusy || this.segments.length === 0) return;

    for (let i = 0; i < Math.min(2, this.segments.length); i++) {
      if (this.segments[i].unloaded) {
        this.reloadUnloadedSegment(i);
        return;
      }
    }

    const firstSeg = this.segments[0];
    if (firstSeg.startChar <= 0) return;

    this.isBusy = true;
    const prevStart = Math.max(0, firstSeg.startChar - this.chunkSize);
    const charsToRead = firstSeg.startChar - prevStart;
    const heightBefore = this.lastKnownScrollHeight;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: prevStart * 2,
      length: charsToRead * 2,
      success: (res) => {
        const str = this.decodeBufferFast(res.buffer);
        const maxActiveCount = Math.max(4, Math.ceil(this.windowChars / this.chunkSize));

        for (let i = maxActiveCount; i < this.segments.length; i++) {
          const seg = this.segments[i];
          if (!seg.unloaded && this.measuredHeights[seg.id]) {
            seg.height = this.measuredHeights[seg.id];
            seg.unloaded = true;
            seg.text = '';
          }
        }

        const newId = this.nextUniqueId++;
        this.segments.unshift({
          id: newId,
          startChar: prevStart,
          charLen: charsToRead,
          text: str,
          height: 300,
          unloaded: false
        });
        this.currentActiveIndex = 0;

        setTimeout(() => {
          this.getScrollHeight((heightAfter) => {
            const addedHeight = Math.max(40, heightAfter - heightBefore);
            this.measuredHeights[newId] = addedHeight;
            if (heightAfter > 0) {
              this.lastKnownScrollHeight = heightAfter;
            }
            try {
              this.$element('scrollViewport').scrollTo({ top: addedHeight, behavior: 'instant' });
            } catch (e) {}
            this.isBusy = false;
          });
        }, 25);
      },
      fail: () => {
        this.isBusy = false;
      }
    });
  },

  reloadUnloadedSegment(index) {
    if (this.isBusy || index < 0 || index >= this.segments.length) return;
    const seg = this.segments[index];
    if (!seg.unloaded) return;

    this.isBusy = true;
    file.readArrayBuffer({
      uri: this.bookUri,
      position: seg.startChar * 2,
      length: seg.charLen * 2,
      success: (res) => {
        const str = this.decodeBufferFast(res.buffer);
        const maxActiveCount = Math.max(4, Math.ceil(this.windowChars / this.chunkSize));
        const allowedRadius = Math.max(2, Math.floor(maxActiveCount / 2));

        for (let i = 0; i < this.segments.length; i++) {
          const other = this.segments[i];
          if (i !== index && !other.unloaded && Math.abs(i - index) > allowedRadius && this.measuredHeights[other.id]) {
            other.height = this.measuredHeights[other.id];
            other.unloaded = true;
            other.text = '';
          }
        }

        seg.text = str;
        seg.unloaded = false;
        this.currentActiveIndex = index;
        this.isBusy = false;
      },
      fail: () => {
        this.isBusy = false;
      }
    });
  },

  onScrollMove(evt) {
    if (!evt || evt.scrollY === undefined || this.segments.length === 0) return;
    const scrollY = Math.max(0, evt.scrollY);

    if (!this.isBusy && this.lastKnownScrollHeight > 0 && (scrollY + 520 + 380) >= this.lastKnownScrollHeight) {
      this.triggerNextChunkLoad();
      return;
    }

    if (this.isBusy) return;

    let accHeight = this.paddingY;
    let visibleChar = this.lastActiveCharOffset;
    let foundIdx = this.currentActiveIndex;

    for (let i = 0; i < this.segments.length; i++) {
      const seg = this.segments[i];
      const segH = this.measuredHeights[seg.id] || seg.height || 300;
      const segBottom = accHeight + segH;

      if (scrollY >= accHeight && scrollY <= segBottom) {
        foundIdx = i;
        const ratio = segH > 0 ? Math.min(1, Math.max(0, (scrollY - accHeight) / segH)) : 0;
        visibleChar = seg.startChar + Math.floor(seg.charLen * ratio);
        break;
      }
      accHeight = segBottom;
    }

    this.currentActiveIndex = foundIdx;

    for (let j = Math.max(0, foundIdx - 1); j <= Math.min(this.segments.length - 1, foundIdx + 1); j++) {
      if (this.segments[j].unloaded) {
        this.reloadUnloadedSegment(j);
        break;
      }
    }

    if (visibleChar >= 0) {
      this.updateProgressMetric(visibleChar);
      this.scheduleProgressSave(visibleChar);
    }
  },

  updateProgressMetric(charPos) {
    if (this.totalChars > 0) {
      const reachedEnd = Math.min(this.totalChars, charPos + this.chunkSize);
      this.progressPercent = Math.min(100, Math.max(0, Math.floor((reachedEnd / this.totalChars) * 100)));
    }
  },

  scheduleProgressSave(charPos) {
    this.lastActiveCharOffset = charPos;
    if (this.saveTimer) return;
    this.saveTimer = setTimeout(() => {
      this.saveTimer = null;
      this.flushProgressNow();
    }, 2000);
  },

  flushProgressNow() {
    const offsetToSave = this.lastActiveCharOffset;
    if (offsetToSave === undefined || !this.bookName) return;

    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      },
      fail: () => {
        const map = {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      }
    });
  },

  updateClock() {
    const d = new Date();
    this.clockTime = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }
}
</script>

<style>
.reader-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.scroll-area {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}

.edge-pad {
  width: 196px;
  flex-shrink: 0;
}

.segment-wrapper {
  width: 196px;
  flex-direction: column;
  flex-shrink: 0;
}

.placeholder-box {
  width: 196px;
  flex-shrink: 0;
}

.book-text {
  width: 196px;
  color: #FFFFFF;
  flex-shrink: 0;
  font-weight: bold;
  text-align: left;
  lines: -1;
}

.top-mask {
  position: absolute;
  top: 0px;
  left: 0px;
  width: 212px;
  background-color: #000000;
  justify-content: center;
  align-items: flex-start;
  padding-top: 4px;
}

.clock-txt {
  width: 212px;
  color: #888888;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
}

.bottom-mask {
  position: absolute;
  bottom: 0px;
  left: 0px;
  width: 212px;
  background-color: #000000;
}
</style>
