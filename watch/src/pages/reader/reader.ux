<template>
  <div class="reader-page">
    <scroll
      id="scrollViewport"
      class="scroll-area"
      scroll-y="true"
      @scroll="onScrollMove"
      @scrolltop="onScrollReachTop"
      @scrollbottom="onScrollReachBottom">

      <div class="edge-pad" style="height: {{topPadHeight}}px;"></div>

      <div
        for="{{segments}}"
        tid="id"
        id="seg_{{$item.id}}"
        class="segment-wrapper"
        style="height: {{$item.boxHeight}};">
        <text
          class="book-text"
          style="font-size: {{fontSize}}px; line-height: {{lineHeight}}px;">{{$item.text}}</text>
      </div>

      <div class="edge-pad" style="height: {{bottomPadHeight}}px;"></div>
    </scroll>

    <div class="top-mask" style="height: {{paddingY}}px;">
      <text class="clock-txt">{{clockTime}}</text>
    </div>

    <div class="bottom-mask" style="height: {{paddingY}}px;"></div>
  </div>
</template>

<script>
import brightness from '@system.brightness'
import storage from '@system.storage'
import file from '@system.file'
import { getStrings, pctToHardwareBrightness } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    clockTime: '00:00',
    stayAwake: true,
    customBrightness: false,
    brightnessPct: 80,
    fontSize: 28,
    lineHeight: 38,
    paddingY: 36,
    topPadHeight: 36,
    bottomPadHeight: 36,
    windowChars: 2400,
    chunkSize: 600,
    totalChars: 0,
    bookUri: '',
    bookName: '',
    segments: [],
    nextUniqueId: 1,
    isBusy: false,
    pendingViewportCheck: false,
    lastKnownScrollHeight: 0,
    lastScrollY: 0,
    currentActiveIndex: 0,
    lastActiveCharOffset: 0,
    progressPercent: 0,
    clockTimer: null,
    saveTimer: null,
    pruneTimer: null
  },

  protected: {
    uri: '',
    name: ''
  },

  onInit() {
    this.bookUri = this.uri;
    this.bookName = this.name;
    this.measuredHeights = {};
    this.collapsedTopSegments = [];
    this.collapsedBottomSegments = [];
    this.topSpacerExtra = 0;
    this.bottomSpacerExtra = 0;
    this.updateClock();
    this.clockTimer = setInterval(() => {
      this.updateClock();
    }, 20000);
  },

  onShow() {
    this.loadSettingsAndStart();
  },

  onHide() {
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  onDestroy() {
    if (this.clockTimer) clearInterval(this.clockTimer);
    if (this.saveTimer) clearTimeout(this.saveTimer);
    if (this.pruneTimer) clearTimeout(this.pruneTimer);
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  syncEdgePads() {
    this.topPadHeight = this.paddingY + this.topSpacerExtra;
    this.bottomPadHeight = this.paddingY + this.bottomSpacerExtra;
  },

  loadSettingsAndStart() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        let lang = 'auto';
        if (data) {
          const cfg = JSON.parse(data);
          this.fontSize = Math.max(8, Math.min(48, cfg.fontSize || 28));
          this.lineHeight = Math.max(10, Math.floor(this.fontSize * 1.35));
          this.windowChars = Math.max(1200, cfg.windowChars || 2400);
          this.chunkSize = 600;
          this.paddingY = Math.max(16, Math.min(120, cfg.paddingY !== undefined ? cfg.paddingY : 36));
          this.stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          this.customBrightness = cfg.customBrightness === true;
          this.brightnessPct = cfg.brightnessPct !== undefined ? cfg.brightnessPct : 80;
          lang = cfg.language || 'auto';
        }
        this.syncEdgePads();
        this.strings = getStrings(lang);
        if (this.customBrightness) {
          brightness.setMode({ mode: 0 });
          brightness.setValue({ value: pctToHardwareBrightness(this.brightnessPct) });
        }
        brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });

        if (this.segments.length === 0) {
          this.initFileMetrics();
        }
      },
      fail: () => {
        this.syncEdgePads();
        this.strings = getStrings('auto');
        brightness.setKeepScreenOn({ keepScreenOn: true });
        if (this.segments.length === 0) {
          this.initFileMetrics();
        }
      }
    });
  },

  initFileMetrics() {
    file.get({
      uri: this.bookUri,
      success: (meta) => {
        this.totalChars = Math.floor(meta.length / 2);
        this.restoreStartOffset();
      },
      fail: () => {
        this.segments = [{
          id: 1,
          startChar: 0,
          charLen: 0,
          text: this.strings.fileError,
          boxHeight: 'auto',
          unloaded: false
        }];
      }
    });
  },

  restoreStartOffset() {
    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        const startOffset = (map[this.bookName] && map[this.bookName].charOffset !== undefined)
          ? map[this.bookName].charOffset
          : 0;
        this.startReadingSession(startOffset);
      },
      fail: () => {
        this.startReadingSession(0);
      }
    });
  },

  decodeBufferFast(u8Buf) {
    if (!u8Buf || u8Buf.length < 2) return '';
    try {
      const u16 = new Uint16Array(u8Buf.buffer, u8Buf.byteOffset, u8Buf.byteLength >> 1);
      return String.fromCharCode.apply(null, u16);
    } catch (e) {
      const codes = [];
      for (let i = 0; i + 1 < u8Buf.length; i += 2) {
        codes.push((u8Buf[i + 1] << 8) | u8Buf[i]);
      }
      return String.fromCharCode.apply(null, codes);
    }
  },

  // Чтение вперёд с сохранением точного consumedLen (чтобы '\n' не переезжал в начало следующего чанка)
  readCleanSlice(startChar, maxLen, callback) {
    if (startChar >= this.totalChars || maxLen <= 0) {
      callback(null, 0);
      return;
    }
    const readLen = Math.min(maxLen, this.totalChars - startChar);
    const isEnd = (startChar + readLen) >= this.totalChars;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: startChar * 2,
      length: readLen * 2,
      success: (res) => {
        let str = this.decodeBufferFast(res.buffer);
        if (!isEnd && str.length > 45) {
          let cut = -1;
          for (let j = str.length - 1; j >= str.length - 40; j--) {
            if (str[j] === ' ' || str[j] === '\n') {
              cut = j + 1;
              break;
            }
          }
          if (cut > 0) {
            str = str.substring(0, cut);
          }
        }
        const consumedLen = str.length;
        if (!isEnd && str.length > 0 && str[str.length - 1] === '\n') {
          str = str.substring(0, str.length - 1);
        }
        callback(str, consumedLen);
      },
      fail: () => {
        callback(null, 0);
      }
    });
  },

  // Чтение назад с выравниванием начала по пробелу или переносу строки
  readCleanSliceBackward(endChar, maxLen, callback) {
    if (endChar <= 0 || maxLen <= 0) {
      callback(null, 0, 0);
      return;
    }
    const rawStart = Math.max(0, endChar - maxLen);
    const rawLen = endChar - rawStart;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: rawStart * 2,
      length: rawLen * 2,
      success: (res) => {
        let str = this.decodeBufferFast(res.buffer);
        let shift = 0;
        if (rawStart > 0 && str.length > 45) {
          for (let j = 0; j < 40; j++) {
            if (str[j] === ' ' || str[j] === '\n') {
              shift = j + 1;
              break;
            }
          }
          if (shift > 0) {
            str = str.substring(shift);
          }
        }
        const actualStart = rawStart + shift;
        const consumedLen = endChar - actualStart;
        if (str.length > 0 && str[str.length - 1] === '\n') {
          str = str.substring(0, str.length - 1);
        }
        callback(str, actualStart, consumedLen);
      },
      fail: () => {
        callback(null, 0, 0);
      }
    });
  },

  estimateSegmentHeight(charLen) {
    const charsPerLine = Math.max(8, Math.floor(196 / (this.fontSize * 0.58)));
    const lines = Math.max(1, Math.ceil(charLen / charsPerLine));
    return lines * this.lineHeight;
  },

  measureSegmentDomHeight(segId, fallbackH, callback) {
    const el = this.$element('seg_' + segId);
    if (el && el.getBoundingClientRect) {
      el.getBoundingClientRect({
        success: (rect) => {
          if (rect && rect.height > 8) {
            this.measuredHeights[segId] = rect.height;
            callback(rect.height);
          } else {
            const h = this.measuredHeights[segId] || fallbackH;
            this.measuredHeights[segId] = h;
            callback(h);
          }
        },
        fail: () => {
          const h = this.measuredHeights[segId] || fallbackH;
          this.measuredHeights[segId] = h;
          callback(h);
        }
      });
    } else {
      const h = this.measuredHeights[segId] || fallbackH;
      this.measuredHeights[segId] = h;
      callback(h);
    }
  },

  recalculateTotalKnownHeight() {
    let sum = this.topPadHeight + this.bottomPadHeight;
    for (let i = 0; i < this.segments.length; i++) {
      const seg = this.segments[i];
      sum += (this.measuredHeights[seg.id] || this.estimateSegmentHeight(seg.charLen));
    }
    this.lastKnownScrollHeight = sum;
  },

  unlockBusyAndContinue() {
    this.isBusy = false;
    if (this.pendingViewportCheck) {
      this.pendingViewportCheck = false;
      this.processViewportAt(this.lastScrollY);
    }
  },

  startReadingSession(savedOffset) {
    if (this.totalChars <= 0) {
      this.segments = [{
        id: 1,
        startChar: 0,
        charLen: 0,
        text: this.strings.emptyFile,
        boxHeight: 'auto',
        unloaded: false
      }];
      return;
    }

    this.isBusy = true;
    const clampedOffset = Math.max(0, Math.min(savedOffset, Math.max(0, this.totalChars - 1)));
    this.lastActiveCharOffset = clampedOffset;
    this.updateProgressMetric(clampedOffset);

    if (clampedOffset > 0) {
      this.readCleanSliceBackward(clampedOffset, this.chunkSize, (prevText, prevStart, prevLen) => {
        const id1 = this.nextUniqueId++;
        this.measuredHeights[id1] = this.estimateSegmentHeight(prevLen);

        this.readCleanSlice(clampedOffset, this.chunkSize * 2, (currText, currLen) => {
          const id2 = this.nextUniqueId++;
          this.measuredHeights[id2] = this.estimateSegmentHeight(currLen);

          this.segments = [
            {
              id: id1,
              startChar: prevStart,
              charLen: prevLen,
              text: prevText || '',
              boxHeight: 'auto',
              unloaded: false
            },
            {
              id: id2,
              startChar: clampedOffset,
              charLen: currLen,
              text: currText || '',
              boxHeight: 'auto',
              unloaded: false
            }
          ];
          this.currentActiveIndex = 1;

          setTimeout(() => {
            this.measureSegmentDomHeight(id1, this.measuredHeights[id1], (seg1RealH) => {
              this.measureSegmentDomHeight(id2, this.measuredHeights[id2], () => {
                this.recalculateTotalKnownHeight();
                this.lastScrollY = seg1RealH;
                try {
                  this.$element('scrollViewport').scrollTo({ top: seg1RealH, behavior: 'instant' });
                } catch (e) {}
                this.unlockBusyAndContinue();
              });
            });
          }, 20);
        });
      });
    } else {
      this.readCleanSlice(0, this.chunkSize * 2, (firstText, firstLen) => {
        const id1 = this.nextUniqueId++;
        this.measuredHeights[id1] = this.estimateSegmentHeight(firstLen);
        this.segments = [{
          id: id1,
          startChar: 0,
          charLen: firstLen,
          text: firstText || '',
          boxHeight: 'auto',
          unloaded: false
        }];
        this.currentActiveIndex = 0;

        setTimeout(() => {
          this.measureSegmentDomHeight(id1, this.measuredHeights[id1], () => {
            this.recalculateTotalKnownHeight();
            this.unlockBusyAndContinue();
          });
        }, 20);
      });
    }
  },

  triggerNextChunkLoad() {
    if (this.isBusy || this.segments.length === 0) return;

    for (let i = Math.max(0, this.segments.length - 2); i < this.segments.length; i++) {
      if (this.segments[i].unloaded) {
        this.reloadUnloadedSegment(i);
        return;
      }
    }

    // Если снизу есть ранее схлопнутый сегмент — восстанавливаем его мгновенно
    if (this.collapsedBottomSegments.length > 0) {
      this.restoreCollapsedBottomSegment();
      return;
    }

    const lastSeg = this.segments[this.segments.length - 1];
    const nextStart = lastSeg.startChar + lastSeg.charLen;
    if (nextStart >= this.totalChars) return;

    this.isBusy = true;

    this.readCleanSlice(nextStart, this.chunkSize, (str, actualLen) => {
      if (str === null || actualLen <= 0) {
        this.unlockBusyAndContinue();
        return;
      }

      const newId = this.nextUniqueId++;
      const estH = this.estimateSegmentHeight(actualLen);
      this.measuredHeights[newId] = estH;

      // Оставляем boxHeight: 'auto', чтобы не вызывать повторный рендер и скачок текста!
      this.segments.push({
        id: newId,
        startChar: nextStart,
        charLen: actualLen,
        text: str,
        boxHeight: 'auto',
        unloaded: false
      });

      this.recalculateTotalKnownHeight();
      // Снимаем блокировку сразу после вставки текста (занимает ~3 мс вместо 60 мс!)
      this.unlockBusyAndContinue();
      this.scheduleIdlePrune();

      // Фоновое точное измерение высоты без блокировки скролла и без изменения boxHeight
      setTimeout(() => {
        this.measureSegmentDomHeight(newId, estH, () => {
          this.recalculateTotalKnownHeight();
        });
      }, 20);
    });
  },

  onScrollReachBottom() {
    this.triggerNextChunkLoad();
  },

  onScrollReachTop() {
    if (this.isBusy || this.segments.length === 0) return;

    for (let i = 0; i < Math.min(2, this.segments.length); i++) {
      if (this.segments[i].unloaded) {
        this.reloadUnloadedSegment(i);
        return;
      }
    }

    // Если сверху есть схлопнутый в спейсер сегмент — возвращаем его без скачка скролла!
    if (this.collapsedTopSegments.length > 0) {
      this.restoreCollapsedTopSegment();
      return;
    }

    const firstSeg = this.segments[0];
    if (firstSeg.startChar <= 0) return;

    this.isBusy = true;

    this.readCleanSliceBackward(firstSeg.startChar, this.chunkSize, (str, prevStart, charsToRead) => {
      if (str === null || charsToRead <= 0) {
        this.unlockBusyAndContinue();
        return;
      }

      const newId = this.nextUniqueId++;
      const estH = this.estimateSegmentHeight(charsToRead);
      this.measuredHeights[newId] = estH;

      this.segments.unshift({
        id: newId,
        startChar: prevStart,
        charLen: charsToRead,
        text: str,
        boxHeight: 'auto',
        unloaded: false
      });
      this.currentActiveIndex++;

      setTimeout(() => {
        this.measureSegmentDomHeight(newId, estH, (addedHeight) => {
          this.recalculateTotalKnownHeight();
          const targetY = this.lastScrollY + addedHeight;
          this.lastScrollY = targetY;
          try {
            this.$element('scrollViewport').scrollTo({ top: targetY, behavior: 'instant' });
          } catch (e) {}
          this.unlockBusyAndContinue();
          this.scheduleIdlePrune();
        });
      }, 16);
    });
  },

  restoreCollapsedTopSegment() {
    const meta = this.collapsedTopSegments.pop();
    if (!meta) return;
    this.isBusy = true;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: meta.startChar * 2,
      length: meta.charLen * 2,
      success: (res) => {
        let str = this.decodeBufferFast(res.buffer);
        if (str.length > 0 && str[str.length - 1] === '\n') {
          str = str.substring(0, str.length - 1);
        }
        // Одновременно уменьшаем верхний спейсер и возвращаем сегмент той же высоты — 0px сдвига!
        this.topSpacerExtra = Math.max(0, this.topSpacerExtra - meta.height);
        this.syncEdgePads();
        this.measuredHeights[meta.id] = meta.height;
        this.segments.unshift({
          id: meta.id,
          startChar: meta.startChar,
          charLen: meta.charLen,
          text: str,
          boxHeight: 'auto',
          unloaded: false
        });
        this.currentActiveIndex = 0;
        this.recalculateTotalKnownHeight();
        this.unlockBusyAndContinue();
        this.scheduleIdlePrune();
      },
      fail: () => {
        this.collapsedTopSegments.push(meta);
        this.unlockBusyAndContinue();
      }
    });
  },

  restoreCollapsedBottomSegment() {
    const meta = this.collapsedBottomSegments.pop();
    if (!meta) return;
    this.isBusy = true;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: meta.startChar * 2,
      length: meta.charLen * 2,
      success: (res) => {
        let str = this.decodeBufferFast(res.buffer);
        if (str.length > 0 && str[str.length - 1] === '\n') {
          str = str.substring(0, str.length - 1);
        }
        this.bottomSpacerExtra = Math.max(0, this.bottomSpacerExtra - meta.height);
        this.syncEdgePads();
        this.measuredHeights[meta.id] = meta.height;
        this.segments.push({
          id: meta.id,
          startChar: meta.startChar,
          charLen: meta.charLen,
          text: str,
          boxHeight: 'auto',
          unloaded: false
        });
        this.recalculateTotalKnownHeight();
        this.unlockBusyAndContinue();
        this.scheduleIdlePrune();
      },
      fail: () => {
        this.collapsedBottomSegments.push(meta);
        this.unlockBusyAndContinue();
      }
    });
  },

  scheduleIdlePrune() {
    if (this.pruneTimer) {
      clearTimeout(this.pruneTimer);
    }
    this.pruneTimer = setTimeout(() => {
      this.pruneTimer = null;
      if (!this.isBusy) {
        this.pruneDistantSegments();
      }
    }, 300);
  },

  pruneDistantSegments() {
    const maxActiveCount = Math.max(6, Math.ceil(this.windowChars / this.chunkSize) + 2);
    const allowedRadius = Math.max(3, Math.floor(maxActiveCount / 2));
    const center = this.currentActiveIndex;

    // 1. Выгружаем текст у далёких сегментов, предварительно точно измерив их высоту
    for (let i = 0; i < this.segments.length; i++) {
      const seg = this.segments[i];
      if (!seg.unloaded && Math.abs(i - center) > allowedRadius) {
        const fallbackH = this.measuredHeights[seg.id] || this.estimateSegmentHeight(seg.charLen);
        this.measureSegmentDomHeight(seg.id, fallbackH, (exactH) => {
          if (Math.abs(i - this.currentActiveIndex) > allowedRadius && !seg.unloaded) {
            seg.boxHeight = exactH + 'px';
            seg.text = '';
            seg.unloaded = true;
          }
        });
      }
    }

    // 2. Защита DOM от раздувания: если сверху или снизу скопилось > 10 пустых коробок,
    // схлопываем крайние в topPadHeight / bottomPadHeight (DOM остаётся чистым!)
    while (this.segments.length > 16 && this.currentActiveIndex > 8 && this.segments[0].unloaded) {
      const removed = this.segments.shift();
      const h = this.measuredHeights[removed.id] || this.estimateSegmentHeight(removed.charLen);
      this.collapsedTopSegments.push({
        id: removed.id,
        startChar: removed.startChar,
        charLen: removed.charLen,
        height: h
      });
      this.topSpacerExtra += h;
      this.currentActiveIndex--;
      this.syncEdgePads();
    }

    while (
      this.segments.length > 16 &&
      this.segments.length - 1 - this.currentActiveIndex > 8 &&
      this.segments[this.segments.length - 1].unloaded
    ) {
      const removed = this.segments.pop();
      const h = this.measuredHeights[removed.id] || this.estimateSegmentHeight(removed.charLen);
      this.collapsedBottomSegments.push({
        id: removed.id,
        startChar: removed.startChar,
        charLen: removed.charLen,
        height: h
      });
      this.bottomSpacerExtra += h;
      this.syncEdgePads();
    }
  },

  reloadUnloadedSegment(index) {
    if (this.isBusy || index < 0 || index >= this.segments.length) return;
    const seg = this.segments[index];
    if (!seg.unloaded) return;

    this.isBusy = true;
    file.readArrayBuffer({
      uri: this.bookUri,
      position: seg.startChar * 2,
      length: seg.charLen * 2,
      success: (res) => {
        let str = this.decodeBufferFast(res.buffer);
        if (str.length > 0 && str[str.length - 1] === '\n') {
          str = str.substring(0, str.length - 1);
        }
        seg.text = str;
        seg.boxHeight = 'auto';
        seg.unloaded = false;
        this.unlockBusyAndContinue();
        this.scheduleIdlePrune();
      },
      fail: () => {
        this.unlockBusyAndContinue();
      }
    });
  },

  onScrollMove(evt) {
    if (!evt || evt.scrollY === undefined || this.segments.length === 0) return;
    const scrollY = Math.max(0, evt.scrollY);
    this.lastScrollY = scrollY;
    this.scheduleIdlePrune();
    this.processViewportAt(scrollY);
  },

  processViewportAt(scrollY) {
    if (this.segments.length === 0) return;
    if (this.isBusy) {
      // Запоминаем, что скролл сдвинулся, чтобы мгновенно обработать позицию после разблокировки
      this.pendingViewportCheck = true;
      return;
    }

    let accHeight = this.topPadHeight;
    let visibleChar = this.lastActiveCharOffset;
    let foundIdx = this.currentActiveIndex;
    const screenMid = scrollY + 220;

    for (let i = 0; i < this.segments.length; i++) {
      const seg = this.segments[i];
      const segH = this.measuredHeights[seg.id] || this.estimateSegmentHeight(seg.charLen);
      const segBottom = accHeight + segH;

      if (screenMid >= accHeight && screenMid <= segBottom) {
        foundIdx = i;
        const ratio = segH > 0 ? Math.min(1, Math.max(0, (scrollY - accHeight) / segH)) : 0;
        visibleChar = seg.startChar + Math.floor(seg.charLen * ratio);
        break;
      } else if (screenMid > segBottom && i === this.segments.length - 1) {
        foundIdx = i;
        visibleChar = seg.startChar + seg.charLen;
      }
      accHeight = segBottom;
    }

    this.currentActiveIndex = foundIdx;

    // Проверяем соседей в радиусе 2 сегментов
    const priorityOrder = [foundIdx, foundIdx + 1, foundIdx - 1, foundIdx + 2, foundIdx - 2];
    for (let k = 0; k < priorityOrder.length; k++) {
      const candidateIdx = priorityOrder[k];
      if (candidateIdx >= 0 && candidateIdx < this.segments.length && this.segments[candidateIdx].unloaded) {
        this.reloadUnloadedSegment(candidateIdx);
        return;
      }
    }

    // Если приблизились к верхнему спейсеру со схлопнутыми сегментами — заранее распаковываем
    if (this.collapsedTopSegments.length > 0 && scrollY <= this.topPadHeight + 450) {
      this.restoreCollapsedTopSegment();
      return;
    }

    // Заблаговременная подгрузка снизу за 900px до конца (почти 2 экрана запаса)
    if (this.lastKnownScrollHeight > 0 && (scrollY + 520 + 900) >= this.lastKnownScrollHeight) {
      this.triggerNextChunkLoad();
      return;
    }

    if (visibleChar >= 0) {
      this.updateProgressMetric(visibleChar);
      this.scheduleProgressSave(visibleChar);
    }
  },

  updateProgressMetric(charPos) {
    if (this.totalChars > 0) {
      const reachedEnd = Math.min(this.totalChars, charPos + this.chunkSize);
      this.progressPercent = Math.min(100, Math.max(0, Math.floor((reachedEnd / this.totalChars) * 100)));
    }
  },

  scheduleProgressSave(charPos) {
    this.lastActiveCharOffset = charPos;
    if (this.saveTimer) return;
    this.saveTimer = setTimeout(() => {
      this.saveTimer = null;
      this.flushProgressNow();
    }, 2000);
  },

  flushProgressNow() {
    const offsetToSave = this.lastActiveCharOffset;
    if (offsetToSave === undefined || !this.bookName) return;

    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      },
      fail: () => {
        const map = {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      }
    });
  },

  updateClock() {
    const d = new Date();
    this.clockTime = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }
}
</script>
