<template>
  <div class="reader-page">
    <div class="top-bar" style="height: {{paddingY}}px;">
      <text class="clock-txt">{{clockTime}}</text>
    </div>

    <list
      id="bookList"
      class="list-area"
      style="height: {{listHeight}}px;"
      @scroll="onListScroll"
      @scrolltop="onListReachTop"
      @scrollbottom="onListReachBottom">

      <list-item
        for="{{lines}}"
        tid="id"
        type="textline"
        class="line-item"
        style="height: {{lineHeight}}px;">
        <text
          class="line-text"
          style="font-size: {{fontSize}}px; line-height: {{lineHeight}}px;">{{$item.text}}</text>
      </list-item>
    </list>

    <div class="bottom-bar" style="height: {{paddingY}}px;"></div>
  </div>
</template>

<script>
import brightness from '@system.brightness'
import storage from '@system.storage'
import file from '@system.file'
import { getStrings, pctToHardwareBrightness } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    clockTime: '00:00',
    stayAwake: true,
    customBrightness: false,
    brightnessPct: 80,
    fontSize: 28,
    lineHeight: 36,
    paddingY: 36,
    listHeight: 448,
    windowChars: 2500,
    chunkChars: 700,
    totalChars: 0,
    bookUri: '',
    bookName: '',
    lines: [],
    nextLineId: 1,
    loadedCharCount: 0,
    isBusy: false,
    lastSavedCharOffset: 0,
    progressPercent: 0,
    clockTimer: null,
    saveTimer: null
  },

  protected: {
    uri: '',
    name: ''
  },

  onInit() {
    this.bookUri = this.uri;
    this.bookName = this.name;
    this.updateClock();
    this.clockTimer = setInterval(() => {
      this.updateClock();
    }, 20000);
  },

  onShow() {
    this.loadSettingsAndStart();
  },

  onHide() {
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  onDestroy() {
    if (this.clockTimer) clearInterval(this.clockTimer);
    if (this.saveTimer) clearTimeout(this.saveTimer);
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  loadSettingsAndStart() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        let lang = 'auto';
        if (data) {
          const cfg = JSON.parse(data);
          this.fontSize = Math.max(8, Math.min(48, cfg.fontSize || 28));
          this.lineHeight = Math.max(12, Math.floor(this.fontSize * 1.32));
          this.windowChars = Math.max(1000, cfg.windowChars || 2500);
          this.chunkChars = Math.max(400, Math.min(900, Math.floor(this.windowChars / 3)));
          this.paddingY = Math.max(16, Math.min(120, cfg.paddingY !== undefined ? cfg.paddingY : 36));
          this.stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          this.customBrightness = cfg.customBrightness === true;
          this.brightnessPct = cfg.brightnessPct !== undefined ? cfg.brightnessPct : 80;
          lang = cfg.language || 'auto';
        }
        this.listHeight = Math.max(200, 520 - (this.paddingY * 2));
        this.strings = getStrings(lang);
        if (this.customBrightness) {
          brightness.setMode({ mode: 0 });
          brightness.setValue({ value: pctToHardwareBrightness(this.brightnessPct) });
        }
        brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });

        if (this.lines.length === 0) {
          this.initFileMetrics();
        }
      },
      fail: () => {
        this.listHeight = 448;
        this.strings = getStrings('auto');
        brightness.setKeepScreenOn({ keepScreenOn: true });
        if (this.lines.length === 0) {
          this.initFileMetrics();
        }
      }
    });
  },

  initFileMetrics() {
    file.get({
      uri: this.bookUri,
      success: (meta) => {
        this.totalChars = Math.floor(meta.length / 2);
        this.restoreStartOffset();
      },
      fail: () => {
        this.lines = [{
          id: 1,
          text: this.strings.fileError,
          charStart: 0,
          charEnd: 0
        }];
      }
    });
  },

  restoreStartOffset() {
    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        const startOffset = (map[this.bookName] && map[this.bookName].charOffset !== undefined)
          ? map[this.bookName].charOffset
          : 0;
        this.openAtOffset(startOffset);
      },
      fail: () => {
        this.openAtOffset(0);
      }
    });
  },

  measureCharWidth(ch, fontPx) {
    const code = ch.charCodeAt(0);
    if (ch === ' ' || ch === '.' || ch === ',' || ch === '!' || ch === ':' || ch === ';' || ch === 'i' || ch === 'l' || ch === 'I' || ch === '1' || ch === '-' || ch === '\'' || ch === '"') {
      return fontPx * 0.34;
    }
    if (ch === 'Ж' || ch === 'Ш' || ch === 'Щ' || ch === 'Ю' || ch === 'М' || ch === 'Ф' || ch === 'Ы' || ch === 'ж' || ch === 'ш' || ch === 'щ' || ch === 'ю' || ch === 'м' || ch === 'ф' || ch === 'ы' || ch === 'W' || ch === 'M' || ch === 'w' || ch === 'm') {
      return fontPx * 0.78;
    }
    if ((code >= 65 && code <= 90) || (code >= 1040 && code <= 1071) || code === 1025) {
      return fontPx * 0.68;
    }
    return fontPx * 0.56;
  },

  splitTextIntoLines(rawText, baseCharOffset) {
    const maxLineWidth = 190;
    const fontPx = this.fontSize;
    const result = [];
    if (!rawText || rawText.length === 0) return result;

    let lineStartIdx = 0;
    let currentLineWidth = 0;
    let lastSpaceIdx = -1;
    let i = 0;

    while (i < rawText.length) {
      const ch = rawText[i];

      if (ch === '\r') {
        i++;
        continue;
      }

      if (ch === '\n') {
        const lineStr = rawText.substring(lineStartIdx, i).replace(/\r/g, '');
        result.push({
          id: this.nextLineId++,
          text: lineStr.length > 0 ? lineStr : ' ',
          charStart: baseCharOffset + lineStartIdx,
          charEnd: baseCharOffset + i + 1
        });
        i++;
        lineStartIdx = i;
        currentLineWidth = 0;
        lastSpaceIdx = -1;
        continue;
      }

      if (ch === ' ') {
        lastSpaceIdx = i;
      }

      const w = this.measureCharWidth(ch, fontPx);
      if (currentLineWidth + w > maxLineWidth && i > lineStartIdx) {
        let breakIdx = i;
        let nextStartIdx = i;

        if (lastSpaceIdx > lineStartIdx) {
          breakIdx = lastSpaceIdx;
          nextStartIdx = lastSpaceIdx + 1;
        }

        const lineStr = rawText.substring(lineStartIdx, breakIdx).replace(/\r/g, '');
        result.push({
          id: this.nextLineId++,
          text: lineStr.length > 0 ? lineStr : ' ',
          charStart: baseCharOffset + lineStartIdx,
          charEnd: baseCharOffset + nextStartIdx
        });

        lineStartIdx = nextStartIdx;
        i = nextStartIdx;
        currentLineWidth = 0;
        lastSpaceIdx = -1;
        continue;
      }

      currentLineWidth += w;
      i++;
    }

    if (lineStartIdx < rawText.length) {
      const tailStr = rawText.substring(lineStartIdx).replace(/\r/g, '');
      if (tailStr.length > 0) {
        result.push({
          id: this.nextLineId++,
          text: tailStr,
          charStart: baseCharOffset + lineStartIdx,
          charEnd: baseCharOffset + rawText.length
        });
      }
    }

    return result;
  },

  readSafeSlice(startChar, maxCharLen, callback) {
    if (startChar >= this.totalChars || maxCharLen <= 0) {
      callback('', startChar, startChar);
      return;
    }
    const actualLen = Math.min(maxCharLen, this.totalChars - startChar);
    const isAtBookEnd = (startChar + actualLen) >= this.totalChars;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: startChar * 2,
      length: actualLen * 2,
      success: (res) => {
        const buf = res.buffer;
        const codes = [];
        for (let i = 0; i + 1 < buf.length; i += 2) {
          codes.push((buf[i + 1] << 8) | buf[i]);
        }
        let str = String.fromCharCode.apply(null, codes);

        if (!isAtBookEnd && str.length > 40) {
          let cutPos = -1;
          for (let j = str.length - 1; j >= str.length - 35; j--) {
            if (str[j] === ' ' || str[j] === '\n') {
              cutPos = j + 1;
              break;
            }
          }
          if (cutPos > 0) {
            str = str.substring(0, cutPos);
          }
        }

        callback(str, startChar, startChar + str.length);
      },
      fail: () => {
        callback(null, startChar, startChar);
      }
    });
  },

  openAtOffset(savedOffset) {
    if (this.totalChars <= 0) {
      this.lines = [{
        id: 1,
        text: this.strings.emptyFile,
        charStart: 0,
        charEnd: 0
      }];
      return;
    }

    this.isBusy = true;
    const clampedOffset = Math.max(0, Math.min(savedOffset, Math.max(0, this.totalChars - 1)));
    this.lastSavedCharOffset = clampedOffset;
    this.updateProgressMetric(clampedOffset);

    if (clampedOffset > 0) {
      const prevStart = Math.max(0, clampedOffset - this.chunkChars);
      const prevDesiredLen = clampedOffset - prevStart;

      this.readSafeSlice(prevStart, prevDesiredLen + this.chunkChars, (combinedStr, actualStart, actualEnd) => {
        if (!combinedStr) {
          this.isBusy = false;
          return;
        }
        const parsedLines = this.splitTextIntoLines(combinedStr, actualStart);
        this.lines = parsedLines;
        this.loadedCharCount = actualEnd - actualStart;

        let targetIdx = 0;
        for (let i = 0; i < parsedLines.length; i++) {
          if (parsedLines[i].charEnd > clampedOffset) {
            targetIdx = i;
            break;
          }
        }

        setTimeout(() => {
          try {
            if (targetIdx > 0) {
              this.$element('bookList').scrollTo({ index: targetIdx, behavior: 'instant' });
            }
          } catch (e) {}
          this.isBusy = false;
        }, 40);
      });
    } else {
      this.readSafeSlice(0, this.chunkChars, (firstStr, actualStart, actualEnd) => {
        if (!firstStr) {
          this.isBusy = false;
          return;
        }
        this.lines = this.splitTextIntoLines(firstStr, actualStart);
        this.loadedCharCount = actualEnd - actualStart;
        this.isBusy = false;
      });
    }
  },

  onListReachBottom() {
    if (this.isBusy || this.lines.length === 0) return;

    const lastLine = this.lines[this.lines.length - 1];
    const nextStart = lastLine.charEnd;
    if (nextStart >= this.totalChars) {
      this.updateProgressMetric(this.totalChars);
      this.scheduleProgressSave(lastLine.charStart);
      return;
    }

    this.isBusy = true;
    this.readSafeSlice(nextStart, this.chunkChars, (newStr, actualStart, actualEnd) => {
      if (!newStr) {
        this.isBusy = false;
        return;
      }

      const newLines = this.splitTextIntoLines(newStr, actualStart);
      if (newLines.length === 0) {
        this.isBusy = false;
        return;
      }

      const addedChars = actualEnd - actualStart;

      if (this.loadedCharCount + addedChars <= this.windowChars) {
        for (let i = 0; i < newLines.length; i++) {
          this.lines.push(newLines[i]);
        }
        this.loadedCharCount += addedChars;
        this.updateProgressMetric(actualEnd);
        this.scheduleProgressSave(lastLine.charStart);
        this.isBusy = false;
      } else {
        const visibleCount = Math.max(4, Math.ceil(this.listHeight / this.lineHeight));
        const keepFromIdx = Math.max(0, this.lines.length - visibleCount);
        const keptLines = this.lines.slice(keepFromIdx);
        const updatedList = keptLines.concat(newLines);

        const firstKeptChar = updatedList[0].charStart;
        this.lines = updatedList;
        this.loadedCharCount = actualEnd - firstKeptChar;

        setTimeout(() => {
          try {
            this.$element('bookList').scrollTo({ index: 0, behavior: 'instant' });
          } catch (e) {}
          this.updateProgressMetric(actualEnd);
          this.scheduleProgressSave(firstKeptChar);
          this.isBusy = false;
        }, 20);
      }
    });
  },

  onListReachTop() {
    if (this.isBusy || this.lines.length === 0) return;

    const firstLine = this.lines[0];
    if (firstLine.charStart <= 0) {
      this.updateProgressMetric(0);
      this.scheduleProgressSave(0);
      return;
    }

    this.isBusy = true;
    const prevStart = Math.max(0, firstLine.charStart - this.chunkChars);
    const desiredLen = firstLine.charStart - prevStart;

    file.readArrayBuffer({
      uri: this.bookUri,
      position: prevStart * 2,
      length: desiredLen * 2,
      success: (res) => {
        const buf = res.buffer;
        const codes = [];
        for (let i = 0; i + 1 < buf.length; i += 2) {
          codes.push((buf[i + 1] << 8) | buf[i]);
        }
        const prevStr = String.fromCharCode.apply(null, codes);
        const prevLines = this.splitTextIntoLines(prevStr, prevStart);

        if (prevLines.length === 0) {
          this.isBusy = false;
          return;
        }

        const maxKeptLines = Math.max(20, Math.floor((this.windowChars / 14)));
        const keptCurrent = this.lines.slice(0, maxKeptLines);
        const combined = prevLines.concat(keptCurrent);

        const lastCombinedChar = combined[combined.length - 1].charEnd;
        this.lines = combined;
        this.loadedCharCount = lastCombinedChar - prevStart;

        const jumpIdx = prevLines.length;
        setTimeout(() => {
          try {
            this.$element('bookList').scrollTo({ index: jumpIdx, behavior: 'instant' });
          } catch (e) {}
          this.updateProgressMetric(firstLine.charStart);
          this.scheduleProgressSave(firstLine.charStart);
          this.isBusy = false;
        }, 20);
      },
      fail: () => {
        this.isBusy = false;
      }
    });
  },

  onListScroll(evt) {
    if (this.isBusy || !evt || this.lines.length === 0) return;
    if (evt.scrollY !== undefined) {
      const approxIdx = Math.min(
        this.lines.length - 1,
        Math.max(0, Math.floor(Math.abs(evt.scrollY) / this.lineHeight))
      );
      const activeLine = this.lines[approxIdx];
      if (activeLine) {
        this.updateProgressMetric(activeLine.charEnd);
        this.scheduleProgressSave(activeLine.charStart);
      }
    }
  },

  updateProgressMetric(charPos) {
    if (this.totalChars > 0) {
      const reached = Math.min(this.totalChars, Math.max(0, charPos));
      this.progressPercent = Math.min(100, Math.max(0, Math.floor((reached / this.totalChars) * 100)));
    }
  },

  scheduleProgressSave(charPos) {
    this.lastSavedCharOffset = charPos;
    if (this.saveTimer) return;
    this.saveTimer = setTimeout(() => {
      this.saveTimer = null;
      this.flushProgressNow();
    }, 2000);
  },

  flushProgressNow() {
    const offsetToSave = this.lastSavedCharOffset;
    if (offsetToSave === undefined || !this.bookName) return;

    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      },
      fail: () => {
        const map = {};
        map[this.bookName] = {
          charOffset: offsetToSave,
          percent: this.progressPercent
        };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      }
    });
  },

  updateClock() {
    const d = new Date();
    this.clockTime = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }
}
</script>

<style>
.reader-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.top-bar {
  width: 212px;
  background-color: #000000;
  justify-content: center;
  align-items: flex-start;
  padding-top: 4px;
  flex-shrink: 0;
}

.clock-txt {
  width: 212px;
  color: #888888;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
}

.list-area {
  width: 200px;
  flex-direction: column;
  flex-shrink: 0;
}

.line-item {
  width: 200px;
  align-items: center;
}

.line-text {
  width: 196px;
  color: #FFFFFF;
  font-weight: bold;
  text-align: left;
  lines: 1;
}

.bottom-bar {
  width: 212px;
  background-color: #000000;
  flex-shrink: 0;
}
</style>
