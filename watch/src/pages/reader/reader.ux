<template>
  <div class="reader-page">
    <div class="top-bar">
      <text class="time-txt">{{clockTime}}</text>
    </div>

    <scroll
      id="scrollViewport"
      class="scroll-area"
      scroll-y="true"
      @scroll="onScrollMove"
      @scrollbottom="onScrollBottom">

      <div class="padding-spacer" style="height: {{paddingY}}px;"></div>
      
      <div for="{{segments}}" class="segment-box">
        <text class="book-text" style="font-size: {{fontSize}}px; line-height: {{lineHeight}}px;">{{$item.text}}</text>
      </div>

      <div class="padding-spacer" style="height: {{paddingY}}px;"></div>
    </scroll>
  </div>
</template>

<script>
import brightness from '@system.brightness'
import storage from '@system.storage'
import file from '@system.file'
import { getStrings } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    clockTime: '00:00',
    stayAwake: true,
    fontSize: 24,
    lineHeight: 34,
    paddingY: 36,
    windowChars: 2000,
    chunkSize: 600,
    totalChars: 0,
    bookUri: '',
    bookName: '',
    segments: [],
    lastMeasuredTotalHeight: 0,
    currentScrollY: 0,
    isLoadingChunk: false,
    progressPercent: 0,
    clockTimer: null,
    saveTimer: null,
    viewportHeight: 520
  },

  protected: { uri: '', name: '' },

  onInit() {
    this.bookUri = this.uri;
    this.bookName = this.name;
    this.updateClock();
    this.clockTimer = setInterval(() => this.updateClock(), 30000);
  },

  onShow() {
    this.loadSettingsAndStart();
  },

  onHide() {
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  onDestroy() {
    if (this.clockTimer) clearInterval(this.clockTimer);
    if (this.saveTimer) clearTimeout(this.saveTimer);
    this.flushProgressNow();
    brightness.setKeepScreenOn({ keepScreenOn: false });
  },

  loadSettingsAndStart() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        let lang = 'auto';
        if (data) {
          const cfg = JSON.parse(data);
          this.fontSize = cfg.fontSize || 24;
          this.lineHeight = Math.floor(this.fontSize * 1.35);
          this.windowChars = Math.max(800, cfg.windowChars || 2000);
          this.chunkSize = Math.max(400, Math.floor(this.windowChars / 3));
          this.paddingY = cfg.paddingY !== undefined ? cfg.paddingY : 36;
          this.stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          lang = cfg.language || 'auto';
          
          if (cfg.customBrightness) {
            const hwVal = Math.max(10, Math.min(255, Math.round((cfg.brightnessPct || 50) * 2.55)));
            brightness.setMode({ mode: 0 });
            brightness.setValue({ value: hwVal });
          } else {
            brightness.setMode({ mode: 1 });
          }
        }
        this.strings = getStrings(lang);
        brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });

        if (this.segments.length === 0) this.initFileMetrics();
      },
      fail: () => {
        brightness.setMode({ mode: 1 });
        this.strings = getStrings('auto');
        brightness.setKeepScreenOn({ keepScreenOn: true });
        if (this.segments.length === 0) this.initFileMetrics();
      }
    });
  },

  initFileMetrics() {
    file.get({
      uri: this.bookUri,
      success: (meta) => {
        this.totalChars = Math.floor(meta.length / 2);
        this.restoreStartOffset();
      },
      fail: () => {
        this.segments = [{ text: this.strings.fileError }];
      }
    });
  },

  restoreStartOffset() {
    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        const savedOffset = (map[this.bookName] && map[this.bookName].charOffset) ? map[this.bookName].charOffset : 0;
        // КЛЮЧЕВОЙ ФИКС: Загружаем текст за 1000 символов ДО сохраненного места, чтобы можно было скроллить назад без рывков.
        const preOffset = Math.max(0, savedOffset - 1000);
        this.startStreamFrom(preOffset);
      },
      fail: () => {
        this.startStreamFrom(0);
      }
    });
  },

  startStreamFrom(startPos) {
    if (this.totalChars <= 0) {
      this.segments = [{ text: this.strings.emptyFile }];
      return;
    }
    this.segments = [];
    this.appendNextChunk(startPos);
  },

  appendNextChunk(startChar) {
    if (this.isLoadingChunk || startChar >= this.totalChars) return;
    this.isLoadingChunk = true;
    
    const charsToRead = Math.min(this.chunkSize, this.totalChars - startChar);
    file.readArrayBuffer({
      uri: this.bookUri,
      position: startChar * 2,
      length: charsToRead * 2,
      success: (res) => {
        let str = '';
        const buf = res.buffer;
        for (let i = 0; i + 1 < buf.length; i += 2) {
          str += String.fromCharCode((buf[i + 1] << 8) | buf[i]);
        }
        
        this.segments.push({
          startChar: startChar,
          charLen: charsToRead,
          text: str
        });
        
        this.pruneMemory();
        this.updateProgressMetric(startChar + charsToRead);
        this.isLoadingChunk = false;
      },
      fail: () => { this.isLoadingChunk = false; }
    });
  },

  pruneMemory() {
    // В QuickApp движок сам оптимизирует скрытые DOM-узлы.
    // Мы ограничиваем массив только для экономии RAM, удаляя самые старые блоки сверху.
    let totalLoaded = 0;
    for (let i = 0; i < this.segments.length; i++) {
      totalLoaded += this.segments[i].charLen;
    }
    while (totalLoaded > this.windowChars && this.segments.length > 3) {
      const removed = this.segments.shift();
      totalLoaded -= removed.charLen;
    }
  },

  onScrollMove(evt) {
    if (!evt || evt.scrollY === undefined) return;
    const scrollY = Math.max(0, evt.scrollY);
    
    // Эвристика прогресса: предполагаем, что прочитано пропорционально скроллу текущих блоков
    if (this.segments.length > 0) {
      const last = this.segments[this.segments.length - 1];
      this.scheduleProgressSave(last.startChar);
    }
  },

  onScrollBottom() {
    if (this.segments.length > 0) {
      const last = this.segments[this.segments.length - 1];
      this.appendNextChunk(last.startChar + last.charLen);
    }
  },

  updateProgressMetric(charPos) {
    if (this.totalChars > 0) {
      this.progressPercent = Math.min(100, Math.max(1, Math.floor((charPos / this.totalChars) * 100)));
    }
  },

  scheduleProgressSave(charPos) {
    this.lastActiveCharOffset = charPos;
    if (this.saveTimer) return;
    this.saveTimer = setTimeout(() => {
      this.saveTimer = null;
      this.flushProgressNow();
    }, 2500);
  },

  flushProgressNow() {
    const offsetToSave = this.lastActiveCharOffset;
    if (offsetToSave === undefined || !this.bookName) return;

    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        const map = data ? JSON.parse(data) : {};
        map[this.bookName] = { charOffset: offsetToSave, percent: this.progressPercent };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      },
      fail: () => {
        const map = {};
        map[this.bookName] = { charOffset: offsetToSave, percent: this.progressPercent };
        storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(map) });
      }
    });
  },

  updateClock() {
    const d = new Date();
    this.clockTime = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }
}
</script>

<style>
.reader-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
  flex-direction: column;
}
.top-bar {
  position: absolute;
  top: 6px;
  left: 0px;
  width: 212px;
  height: 28px;
  justify-content: center;
  align-items: center;
  z-index: 10;
}
.time-txt {
  color: #666666;
  font-size: 20px;
  font-weight: bold;
}
.scroll-area {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}
.padding-spacer {
  width: 200px;
  flex-shrink: 0;
}
.segment-box {
  width: 196px;
  flex-direction: column;
  flex-shrink: 0;
}
.book-text {
  width: 196px;
  color: #E0E0E0;
  text-align: left;
  lines: -1;
  flex-shrink: 0;
}
</style>
