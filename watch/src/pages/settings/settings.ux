<template>
  <div class="settings-page">
    <scroll class="settings-scroll" scroll-y="true">
      <div class="edge-spacer"></div>

      <div class="back-btn" @click="goBack">
        <text class="back-btn-txt" style="font-size: {{backBtnFont}}px;">{{strings.back}}</text>
      </div>

      <div class="{{hasUnsavedChanges ? 'save-btn save-btn-active' : 'save-btn'}}" @click="saveNow">
        <text class="{{hasUnsavedChanges ? 'save-btn-txt-active' : 'save-btn-txt'}}" style="font-size: {{saveBtnFont}}px;">{{justSaved ? strings.savedStatus : strings.saveSettings}}</text>
      </div>

      <div class="card">
        <text class="card-title" style="font-size: {{langTitleFont}}px;">{{strings.language}}</text>
        <div class="toggle-btn toggle-on" @click="cycleLanguage">
          <text class="toggle-txt-on" style="font-size: {{langBtnFont}}px;">{{languageLabel}}</text>
        </div>
      </div>

      <div class="card">
        <text class="card-title" style="font-size: {{keepTitleFont}}px;">{{strings.keepScreenOn}}</text>
        <div class="toggle-btn {{stayAwake ? 'toggle-on' : 'toggle-off'}}" @click="toggleStayAwake">
          <text class="{{stayAwake ? 'toggle-txt-on' : 'toggle-txt-off'}}">{{stayAwake ? strings.enabled : strings.disabled}}</text>
        </div>
      </div>

      <div class="card">
        <text class="card-title" style="font-size: {{customBrTitleFont}}px;">{{strings.customBrightness}}</text>
        <div class="toggle-btn {{customBrightness ? 'toggle-on' : 'toggle-off'}}" @click="toggleCustomBrightness">
          <text class="{{customBrightness ? 'toggle-txt-on' : 'toggle-txt-off'}}">{{customBrightness ? strings.enabled : strings.disabled}}</text>
        </div>
      </div>

      <div class="card" if="{{customBrightness}}">
        <text class="card-title" style="font-size: {{brTitleFont}}px;">{{strings.brightness}}</text>
        <div class="ctrl-row">
          <div class="ctrl-btn" @click="changeBrightness(-10)">
            <text class="ctrl-btn-txt">-</text>
          </div>
          <text class="ctrl-val">{{brightnessPct}}%</text>
          <div class="ctrl-btn" @click="changeBrightness(10)">
            <text class="ctrl-btn-txt">+</text>
          </div>
        </div>
      </div>

      <div class="card-tall">
        <text class="card-title" style="font-size: {{fontTitleFont}}px;">{{strings.fontSize}}</text>
        <text class="preview-txt" style="font-size: {{fontSize}}px;">{{strings.sampleText}}</text>
        <div class="ctrl-row">
          <div class="ctrl-btn" @click="changeFont(-1)">
            <text class="ctrl-btn-txt">-</text>
          </div>
          <text class="ctrl-val">{{fontSize}}px</text>
          <div class="ctrl-btn" @click="changeFont(1)">
            <text class="ctrl-btn-txt">+</text>
          </div>
        </div>
      </div>

      <div class="card">
        <text class="card-title" style="font-size: {{bufTitleFont}}px;">{{strings.bufferSize}}</text>
        <div class="ctrl-row">
          <div class="ctrl-btn" @click="changeWindow(-500)">
            <text class="ctrl-btn-txt">-</text>
          </div>
          <text class="ctrl-val">{{windowChars}}</text>
          <div class="ctrl-btn" @click="changeWindow(500)">
            <text class="ctrl-btn-txt">+</text>
          </div>
        </div>
      </div>

      <div class="card">
        <text class="card-title" style="font-size: {{padTitleFont}}px;">{{strings.edgePadding}}</text>
        <div class="ctrl-row">
          <div class="ctrl-btn" @click="changePadding(-4)">
            <text class="ctrl-btn-txt">-</text>
          </div>
          <text class="ctrl-val">{{paddingY}}px</text>
          <div class="ctrl-btn" @click="changePadding(4)">
            <text class="ctrl-btn-txt">+</text>
          </div>
        </div>
      </div>

      <div class="storage-card">
        <text class="storage-title">{{strings.storageTitle}}</text>
        <text class="storage-line">{{strings.storageBooks}}: {{booksSizeText}} ({{booksCount}})</text>
        <text class="storage-line">{{strings.storageSystem}}: {{sysSizeText}}</text>
        <text class="storage-line">{{strings.storageUsed}}: {{totalUsedText}}</text>
        <text class="storage-line-free">{{strings.storageFree}}: {{freeSpaceText}}</text>
      </div>

      <div class="card-double">
        <text class="card-title" style="font-size: {{cleanCardTitleFont}}px;">{{strings.resetAndCleanTitle}}</text>

        <div class="toggle-btn {{confirmDeleteAll ? 'toggle-on' : 'toggle-off'}}" @click="onDeleteAllTap">
          <text class="{{confirmDeleteAll ? 'toggle-txt-on' : 'toggle-txt-off'}}" style="font-size: {{delAllBtnFont}}px;">{{deletedAllDone ? strings.deleteAllDone : (confirmDeleteAll ? strings.deleteAllConfirm : strings.deleteAllBtn)}}</text>
        </div>

        <div class="toggle-btn {{confirmReset ? 'toggle-on' : 'toggle-off'}}" @click="onResetTap">
          <text class="{{confirmReset ? 'toggle-txt-on' : 'toggle-txt-off'}}" style="font-size: {{resetBtnFont}}px;">{{confirmReset ? strings.resetConfirm : strings.resetSettings}}</text>
        </div>
      </div>

      <div class="edge-spacer-bottom"></div>
    </scroll>
  </div>
</template>

<script>
import storage from '@system.storage'
import brightness from '@system.brightness'
import file from '@system.file'
import device from '@system.device'
import router from '@system.router'
import { getStrings, pctToHardwareBrightness, fitFontSize } from '../../services/Localization'

const BOOKS_DIRECTORY = 'internal://files/books/';

export default {
  private: {
    strings: getStrings('auto'),
    language: 'auto',
    languageLabel: 'Auto',
    windowChars: 2000,
    fontSize: 28,
    paddingY: 36,
    stayAwake: true,
    customBrightness: false,
    brightnessPct: 80,
    savedCustomBrightness: false,
    savedBrightnessPct: 80,
    savedStayAwake: true,
    hasUnsavedChanges: false,
    justSaved: false,
    confirmReset: false,
    confirmDeleteAll: false,
    deletedAllDone: false,
    backBtnFont: 22,
    saveBtnFont: 22,
    langTitleFont: 20,
    langBtnFont: 20,
    keepTitleFont: 20,
    customBrTitleFont: 20,
    brTitleFont: 20,
    fontTitleFont: 20,
    bufTitleFont: 20,
    padTitleFont: 20,
    cleanCardTitleFont: 20,
    delAllBtnFont: 18,
    resetBtnFont: 18,
    booksCount: 0,
    booksSizeText: '0 KB',
    sysSizeText: '0.5 KB',
    totalUsedText: '0.5 KB',
    freeSpaceText: '...'
  },

  onInit() {
    this.loadSavedSettings();
    this.inspectStorage();
  },

  onHide() {
    if (this.hasUnsavedChanges) {
      this.restoreSavedHardwareState();
    }
  },

  onDestroy() {
    if (this.hasUnsavedChanges) {
      this.restoreSavedHardwareState();
    }
  },

  restoreSavedHardwareState() {
    if (this.savedCustomBrightness) {
      brightness.setMode({ mode: 0 });
      brightness.setValue({ value: pctToHardwareBrightness(this.savedBrightnessPct) });
    } else {
      brightness.setMode({ mode: 1 });
    }
    brightness.setKeepScreenOn({ keepScreenOn: this.savedStayAwake });
  },

  updateAdaptiveFonts() {
    const s = this.strings;
    this.backBtnFont = fitFontSize(s.back, 172, 24, 15, true);
    const saveTxt = this.justSaved ? s.savedStatus : s.saveSettings;
    this.saveBtnFont = fitFontSize(saveTxt, 172, 24, 15, true);
    this.langTitleFont = fitFontSize(s.language, 172, 21, 15, false);
    this.langBtnFont = fitFontSize(this.languageLabel, 164, 22, 15, true);
    this.keepTitleFont = fitFontSize(s.keepScreenOn, 172, 20, 15, false);
    this.customBrTitleFont = fitFontSize(s.customBrightness, 172, 20, 15, false);
    this.brTitleFont = fitFontSize(s.brightness, 172, 21, 15, false);
    this.fontTitleFont = fitFontSize(s.fontSize, 172, 20, 15, false);
    this.bufTitleFont = fitFontSize(s.bufferSize, 172, 20, 15, false);
    this.padTitleFont = fitFontSize(s.edgePadding, 172, 20, 15, false);
    this.cleanCardTitleFont = fitFontSize(s.resetAndCleanTitle, 172, 20, 15, false);
    const delBtnTxt = this.deletedAllDone ? s.deleteAllDone : (this.confirmDeleteAll ? s.deleteAllConfirm : s.deleteAllBtn);
    this.delAllBtnFont = fitFontSize(delBtnTxt, 164, 19, 14, true);
    const resetBtnTxt = this.confirmReset ? s.resetConfirm : s.resetSettings;
    this.resetBtnFont = fitFontSize(resetBtnTxt, 164, 19, 14, true);
  },

  loadSavedSettings() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        if (data) {
          const cfg = JSON.parse(data);
          this.windowChars = cfg.windowChars || 2000;
          this.fontSize = Math.max(8, Math.min(48, cfg.fontSize || 28));
          this.paddingY = cfg.paddingY !== undefined ? cfg.paddingY : 36;
          this.stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          this.customBrightness = cfg.customBrightness === true;
          this.brightnessPct = cfg.brightnessPct !== undefined ? cfg.brightnessPct : 80;
          this.language = cfg.language || 'auto';
        }
        this.savedCustomBrightness = this.customBrightness;
        this.savedBrightnessPct = this.brightnessPct;
        this.savedStayAwake = this.stayAwake;
        this.hasUnsavedChanges = false;
        this.applyLanguagePreview();
        this.applyBrightnessPreview();
        brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });
      },
      fail: () => {
        this.applyLanguagePreview();
      }
    });
  },

  markModified() {
    this.hasUnsavedChanges = true;
    this.justSaved = false;
    this.confirmReset = false;
    this.confirmDeleteAll = false;
    this.updateAdaptiveFonts();
  },

  formatBytes(bytes) {
    if (!bytes || bytes <= 0) return '0 KB';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(2) + ' MB';
  },

  inspectStorage() {
    let booksBytes = 0;
    let count = 0;
    const sysBytes = 512;

    file.list({
      uri: BOOKS_DIRECTORY,
      success: (data) => {
        if (data && data.fileList) {
          data.fileList.forEach(item => {
            if (item.type === 'file') {
              count++;
              booksBytes += (item.length || 0);
            }
          });
        }
        this.booksCount = count;
        this.booksSizeText = this.formatBytes(booksBytes);
        this.sysSizeText = this.formatBytes(sysBytes);
        this.totalUsedText = this.formatBytes(booksBytes + sysBytes);
        this.queryDeviceSpace(booksBytes + sysBytes);
      },
      fail: () => {
        this.booksCount = 0;
        this.booksSizeText = '0 KB';
        this.sysSizeText = this.formatBytes(sysBytes);
        this.totalUsedText = this.formatBytes(sysBytes);
        this.queryDeviceSpace(sysBytes);
      }
    });
  },

  queryDeviceSpace(usedByApp) {
    if (device && device.getAvailableStorage) {
      device.getAvailableStorage({
        success: (res) => {
          if (res && res.availableStorage !== undefined) {
            this.freeSpaceText = this.formatBytes(res.availableStorage);
          } else {
            this.freeSpaceText = this.formatBytes(Math.max(0, 8388608 - usedByApp));
          }
        },
        fail: () => {
          this.freeSpaceText = this.formatBytes(Math.max(0, 8388608 - usedByApp));
        }
      });
    } else {
      this.freeSpaceText = this.formatBytes(Math.max(0, 8388608 - usedByApp));
    }
  },

  applyLanguagePreview() {
    this.strings = getStrings(this.language);
    if (this.language === 'en') {
      this.languageLabel = this.strings.langEn;
    } else if (this.language === 'ru') {
      this.languageLabel = this.strings.langRu;
    } else {
      this.languageLabel = this.strings.langAuto;
    }
    this.updateAdaptiveFonts();
  },

  applyBrightnessPreview() {
    if (this.customBrightness) {
      brightness.setMode({ mode: 0 });
      brightness.setValue({ value: pctToHardwareBrightness(this.brightnessPct) });
    } else {
      brightness.setMode({ mode: 1 });
    }
  },

  cycleLanguage() {
    if (this.language === 'auto') {
      this.language = 'en';
    } else if (this.language === 'en') {
      this.language = 'ru';
    } else {
      this.language = 'auto';
    }
    this.markModified();
    this.applyLanguagePreview();
  },

  toggleStayAwake() {
    this.stayAwake = !this.stayAwake;
    this.markModified();
    brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });
  },

  toggleCustomBrightness() {
    this.customBrightness = !this.customBrightness;
    this.markModified();
    this.applyBrightnessPreview();
  },

  changeBrightness(delta) {
    if (!this.customBrightness) return;
    if (this.brightnessPct === 1 && delta > 0) {
      this.brightnessPct = 10;
    } else if (this.brightnessPct === 10 && delta < 0) {
      this.brightnessPct = 1;
    } else {
      const next = Math.round((this.brightnessPct + delta) / 10) * 10;
      this.brightnessPct = Math.max(1, Math.min(100, next));
    }
    this.markModified();
    this.applyBrightnessPreview();
  },

  changeWindow(delta) {
    this.windowChars = Math.max(1000, Math.min(15000, this.windowChars + delta));
    this.markModified();
  },

  changeFont(delta) {
    this.fontSize = Math.max(8, Math.min(48, this.fontSize + delta));
    this.markModified();
  },

  changePadding(delta) {
    this.paddingY = Math.max(16, Math.min(120, this.paddingY + delta));
    this.markModified();
  },

  onDeleteAllTap() {
    if (!this.confirmDeleteAll) {
      this.confirmDeleteAll = true;
      this.deletedAllDone = false;
      this.confirmReset = false;
      this.updateAdaptiveFonts();
      return;
    }

    this.confirmDeleteAll = false;
    storage.delete({ key: 'WRISTBOOK_PROGRESS' });

    file.list({
      uri: BOOKS_DIRECTORY,
      success: (data) => {
        const files = (data && data.fileList) ? data.fileList.filter(f => f.type === 'file') : [];
        this.deleteFilesSequentially(files, 0, () => {
          this.deletedAllDone = true;
          this.updateAdaptiveFonts();
          this.inspectStorage();
        });
      },
      fail: () => {
        this.deletedAllDone = true;
        this.updateAdaptiveFonts();
        this.inspectStorage();
      }
    });
  },

  deleteFilesSequentially(files, index, onDone) {
    if (index >= files.length) {
      if (onDone) onDone();
      return;
    }
    file.delete({
      uri: files[index].uri,
      complete: () => {
        this.deleteFilesSequentially(files, index + 1, onDone);
      }
    });
  },

  saveNow() {
    this.savedCustomBrightness = this.customBrightness;
    this.savedBrightnessPct = this.brightnessPct;
    this.savedStayAwake = this.stayAwake;
    this.hasUnsavedChanges = false;
    this.justSaved = true;
    this.confirmReset = false;
    this.confirmDeleteAll = false;
    this.updateAdaptiveFonts();

    storage.set({
      key: 'WRISTBOOK_CONFIG',
      value: JSON.stringify({
        language: this.language,
        windowChars: this.windowChars,
        fontSize: this.fontSize,
        paddingY: this.paddingY,
        stayAwake: this.stayAwake,
        customBrightness: this.customBrightness,
        brightnessPct: this.brightnessPct
      })
    });
  },

  onResetTap() {
    if (!this.confirmReset) {
      this.confirmReset = true;
      this.confirmDeleteAll = false;
      this.updateAdaptiveFonts();
      return;
    }
    this.confirmReset = false;
    this.language = 'auto';
    this.stayAwake = true;
    this.customBrightness = false;
    this.brightnessPct = 80;
    this.fontSize = 28;
    this.windowChars = 2000;
    this.paddingY = 36;
    this.applyLanguagePreview();
    brightness.setKeepScreenOn({ keepScreenOn: true });
    this.saveNow();
  },

  goBack() {
    router.back();
  }
}
</script>

<style>
.settings-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.settings-scroll {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}

.edge-spacer {
  width: 200px;
  height: 36px;
  flex-shrink: 0;
}

.edge-spacer-bottom {
  width: 200px;
  height: 56px;
  flex-shrink: 0;
}

.back-btn {
  width: 200px;
  height: 68px;
  flex-shrink: 0;
  background-color: #262626;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn-txt {
  color: #FFFFFF;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.save-btn {
  width: 200px;
  height: 68px;
  flex-shrink: 0;
  background-color: #2E2E2E;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  margin-bottom: 12px;
}

.save-btn-active {
  background-color: #FFFFFF;
}

.save-btn-txt {
  color: #CCCCCC;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.save-btn-txt-active {
  color: #000000;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.card {
  width: 200px;
  height: 152px;
  flex-shrink: 0;
  background-color: #1A1A1A;
  border-radius: 26px;
  padding: 12px 10px;
  margin-bottom: 10px;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.card-tall {
  width: 200px;
  height: 200px;
  flex-shrink: 0;
  background-color: #1A1A1A;
  border-radius: 26px;
  padding: 12px 10px;
  margin-bottom: 10px;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.card-double {
  width: 200px;
  height: 218px;
  flex-shrink: 0;
  background-color: #1A1A1A;
  border-radius: 26px;
  padding: 12px 10px;
  margin-bottom: 10px;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.storage-card {
  width: 200px;
  height: 176px;
  flex-shrink: 0;
  background-color: #1A1A1A;
  border-radius: 26px;
  padding: 12px 12px;
  margin-bottom: 10px;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
}

.storage-title {
  width: 176px;
  color: #FFFFFF;
  font-size: 19px;
  font-weight: bold;
  text-align: center;
}

.storage-line {
  width: 176px;
  color: #BBBBBB;
  font-size: 15px;
  font-weight: bold;
  lines: 1;
}

.storage-line-free {
  width: 176px;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: bold;
  lines: 1;
}

.card-title {
  width: 176px;
  color: #FFFFFF;
  font-weight: bold;
  text-align: center;
  lines: 2;
}

.preview-txt {
  color: #FFFFFF;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.toggle-btn {
  width: 176px;
  height: 60px;
  flex-shrink: 0;
  border-radius: 22px;
  padding: 0 6px;
  justify-content: center;
  align-items: center;
}

.toggle-on {
  background-color: #FFFFFF;
}

.toggle-off {
  background-color: #303030;
}

.toggle-txt-on {
  color: #000000;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.toggle-txt-off {
  color: #FFFFFF;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.ctrl-row {
  width: 176px;
  height: 60px;
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
}

.ctrl-btn {
  width: 56px;
  height: 60px;
  flex-shrink: 0;
  background-color: #303030;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
}

.ctrl-btn-txt {
  color: #FFFFFF;
  font-size: 32px;
  font-weight: bold;
}

.ctrl-val {
  color: #FFFFFF;
  font-size: 24px;
  font-weight: bold;
}
</style>
