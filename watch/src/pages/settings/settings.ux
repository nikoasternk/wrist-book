<template>
  <div class="settings-page">
    <scroll class="settings-scroll" scroll-y="true">
      <div class="settings-content">
        <div class="back-btn" @click="goBack">
          <text class="back-btn-txt">{{strings.back}}</text>
        </div>

        <div class="card">
          <text class="card-title">{{strings.language}}</text>
          <div class="toggle-btn toggle-on" @click="cycleLanguage">
            <text class="toggle-txt">{{languageLabel}}</text>
          </div>
        </div>

        <div class="card">
          <text class="card-title">{{strings.keepScreenOn}}</text>
          <div class="toggle-btn {{stayAwake ? 'toggle-on' : 'toggle-off'}}" @click="toggleStayAwake">
            <text class="toggle-txt">{{stayAwake ? strings.enabled : strings.disabled}}</text>
          </div>
        </div>

        <div class="card">
          <text class="card-title">{{strings.brightness}}</text>
          <text class="preview-txt" style="color: rgba(255,255,255,{{brightnessPct / 100}});">{{strings.sampleText}}</text>
          <div class="ctrl-row">
            <div class="ctrl-btn" @click="changeBrightness(-10)">
              <text class="ctrl-btn-txt">-</text>
            </div>
            <text class="ctrl-val">{{brightnessPct}}%</text>
            <div class="ctrl-btn" @click="changeBrightness(10)">
              <text class="ctrl-btn-txt">+</text>
            </div>
          </div>
        </div>

        <div class="card">
          <text class="card-title">{{strings.fontSize}}</text>
          <div class="ctrl-row">
            <div class="ctrl-btn" @click="changeFont(-2)">
              <text class="ctrl-btn-txt">-</text>
            </div>
            <text class="ctrl-val">{{fontSize}}</text>
            <div class="ctrl-btn" @click="changeFont(2)">
              <text class="ctrl-btn-txt">+</text>
            </div>
          </div>
        </div>

        <div class="card">
          <text class="card-title">{{strings.bufferSize}}</text>
          <div class="ctrl-row">
            <div class="ctrl-btn" @click="changeWindow(-500)">
              <text class="ctrl-btn-txt">-</text>
            </div>
            <text class="ctrl-val">{{windowChars}}</text>
            <div class="ctrl-btn" @click="changeWindow(500)">
              <text class="ctrl-btn-txt">+</text>
            </div>
          </div>
        </div>

        <div class="card">
          <text class="card-title">{{strings.edgePadding}}</text>
          <div class="ctrl-row">
            <div class="ctrl-btn" @click="changePadding(-4)">
              <text class="ctrl-btn-txt">-</text>
            </div>
            <text class="ctrl-val">{{paddingY}}</text>
            <div class="ctrl-btn" @click="changePadding(4)">
              <text class="ctrl-btn-txt">+</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import storage from '@system.storage'
import brightness from '@system.brightness'
import router from '@system.router'
import { getStrings } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    language: 'auto',
    languageLabel: 'Auto',
    windowChars: 1500,
    fontSize: 30,
    paddingY: 38,
    stayAwake: true,
    brightnessPct: 100
  },

  onInit() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        if (data) {
          const cfg = JSON.parse(data);
          this.windowChars = cfg.windowChars || 1500;
          this.fontSize = cfg.fontSize || 30;
          this.paddingY = cfg.paddingY !== undefined ? cfg.paddingY : 38;
          this.stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          this.brightnessPct = cfg.brightnessPct || 100;
          this.language = cfg.language || 'auto';
        }
        this.applyLanguage();
        brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });
      },
      fail: () => {
        this.applyLanguage();
      }
    });
  },

  applyLanguage() {
    this.strings = getStrings(this.language);
    if (this.language === 'en') {
      this.languageLabel = this.strings.langEn;
    } else if (this.language === 'ru') {
      this.languageLabel = this.strings.langRu;
    } else {
      this.languageLabel = this.strings.langAuto;
    }
  },

  cycleLanguage() {
    if (this.language === 'auto') {
      this.language = 'en';
    } else if (this.language === 'en') {
      this.language = 'ru';
    } else {
      this.language = 'auto';
    }
    this.applyLanguage();
    this.save();
  },

  toggleStayAwake() {
    this.stayAwake = !this.stayAwake;
    brightness.setKeepScreenOn({ keepScreenOn: this.stayAwake });
    this.save();
  },

  changeBrightness(delta) {
    this.brightnessPct = Math.max(10, Math.min(100, this.brightnessPct + delta));
    const hwVal = Math.max(10, Math.min(255, Math.round(this.brightnessPct * 2.55)));
    brightness.setMode({ mode: 0 });
    brightness.setValue({ value: hwVal });
    this.save();
  },

  changeWindow(delta) {
    this.windowChars = Math.max(500, Math.min(15000, this.windowChars + delta));
    this.save();
  },

  changeFont(delta) {
    this.fontSize = Math.max(20, Math.min(48, this.fontSize + delta));
    this.save();
  },

  changePadding(delta) {
    this.paddingY = Math.max(16, Math.min(76, this.paddingY + delta));
    this.save();
  },

  save() {
    storage.set({
      key: 'WRISTBOOK_CONFIG',
      value: JSON.stringify({
        language: this.language,
        windowChars: this.windowChars,
        fontSize: this.fontSize,
        paddingY: this.paddingY,
        stayAwake: this.stayAwake,
        brightnessPct: this.brightnessPct
      })
    });
  },

  goBack() {
    router.back();
  }
}
</script>

<style>
.settings-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.settings-scroll {
  width: 212px;
  height: 520px;
}

.settings-content {
  width: 212px;
  padding: 36px 6px 60px 6px;
  flex-direction: column;
  align-items: center;
}

.back-btn {
  width: 200px;
  height: 76px;
  background-color: #262626;
  border-radius: 28px;
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.back-btn-txt {
  color: #FFFFFF;
  font-size: 28px;
  font-weight: bold;
}

.card {
  width: 200px;
  background-color: #1C1C1C;
  border-radius: 28px;
  padding: 16px 10px;
  margin-bottom: 12px;
  flex-direction: column;
  align-items: center;
}

.card-title {
  width: 180px;
  color: #FFFFFF;
  font-size: 26px;
  font-weight: bold;
  text-align: center;
  lines: -1;
}

.preview-txt {
  font-size: 24px;
  font-weight: bold;
  margin-top: 6px;
}

.toggle-btn {
  width: 180px;
  height: 72px;
  border-radius: 24px;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}

.toggle-on {
  background-color: #0D91FF;
}

.toggle-off {
  background-color: #333333;
}

.toggle-txt {
  color: #FFFFFF;
  font-size: 26px;
  font-weight: bold;
}

.ctrl-row {
  width: 180px;
  margin-top: 12px;
  justify-content: space-between;
  align-items: center;
}

.ctrl-btn {
  width: 60px;
  height: 64px;
  background-color: #2E2E2E;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
}

.ctrl-btn-txt {
  color: #FFFFFF;
  font-size: 34px;
  font-weight: bold;
}

.ctrl-val {
  color: #4C8DFF;
  font-size: 30px;
  font-weight: bold;
}
</style>