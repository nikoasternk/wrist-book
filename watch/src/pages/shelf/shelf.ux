<template>
  <div class="shelf-page">
    <scroll class="main-scroll" scroll-y="true">
      <div class="scroll-inner">
        <text class="app-title">{{strings.appName}}</text>

        <div class="settings-btn" @click="openSettings">
          <text class="settings-btn-txt">{{strings.settings}}</text>
        </div>

        <div class="book-card" for="{{bookList}}" @click="openBook($item)">
          <text class="book-title">{{$item.name}}</text>
          <text class="book-sub">{{$item.percent}}%</text>
        </div>

        <div class="empty-box" if="{{bookList.length === 0}}">
          <text class="empty-title">{{strings.emptyTitle}}</text>
          <text class="empty-desc">{{strings.emptySubtitle}}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import file from '@system.file'
import storage from '@system.storage'
import brightness from '@system.brightness'
import router from '@system.router'
import { getStrings } from '../../services/Localization'

const BOOKS_DIRECTORY = 'internal://files/books/';

export default {
  private: {
    strings: getStrings('auto'),
    bookList: [],
    progressMap: {}
  },

  onShow() {
    this.loadConfiguration();
    this.loadBooks();
  },

  loadConfiguration() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        let stayAwake = true;
        let lang = 'auto';
        if (data) {
          const cfg = JSON.parse(data);
          stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          lang = cfg.language || 'auto';
          if (cfg.brightnessPct) {
            const hwVal = Math.max(10, Math.min(255, Math.round(cfg.brightnessPct * 2.55)));
            brightness.setMode({ mode: 0 });
            brightness.setValue({ value: hwVal });
          }
        }
        this.strings = getStrings(lang);
        brightness.setKeepScreenOn({ keepScreenOn: stayAwake });
      },
      fail: () => {
        this.strings = getStrings('auto');
        brightness.setKeepScreenOn({ keepScreenOn: true });
      }
    });
  },

  loadBooks() {
    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        this.progressMap = data ? JSON.parse(data) : {};
        this.scanDirectory();
      },
      fail: () => {
        this.progressMap = {};
        this.scanDirectory();
      }
    });
  },

  scanDirectory() {
    file.list({
      uri: BOOKS_DIRECTORY,
      success: (data) => {
        if (data && data.fileList) {
          this.bookList = data.fileList
            .filter(item => item.type === 'file')
            .map(item => {
              const displayName = item.uri.split('/').pop().replace(/\.txt$/i, '');
              const saved = this.progressMap[displayName] || { percent: 0 };
              return {
                uri: item.uri,
                name: displayName,
                percent: saved.percent || 0
              };
            });
        } else {
          this.bookList = [];
        }
      },
      fail: () => {
        this.bookList = [];
      }
    });
  },

  openBook(item) {
    router.push({
      uri: 'pages/reader',
      params: { uri: item.uri, name: item.name }
    });
  },

  openSettings() {
    router.push({ uri: 'pages/settings' });
  }
}
</script>

<style>
.shelf-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.main-scroll {
  width: 212px;
  height: 520px;
}

.scroll-inner {
  width: 212px;
  padding: 36px 6px 60px 6px;
  flex-direction: column;
  align-items: center;
}

.app-title {
  width: 200px;
  color: #FFFFFF;
  font-size: 32px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 14px;
}

.settings-btn {
  width: 200px;
  height: 76px;
  background-color: #1F2937;
  border-radius: 28px;
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.settings-btn-txt {
  color: #60A5FA;
  font-size: 28px;
  font-weight: bold;
}

.book-card {
  width: 200px;
  min-height: 112px;
  background-color: #262626;
  border-radius: 30px;
  padding: 16px 14px;
  margin-bottom: 10px;
  flex-direction: column;
  justify-content: space-between;
}

.book-title {
  width: 172px;
  color: #FFFFFF;
  font-size: 30px;
  line-height: 36px;
  font-weight: bold;
  lines: 2;
  text-overflow: ellipsis;
}

.book-sub {
  width: 172px;
  color: #A8A8A8;
  font-size: 26px;
  line-height: 32px;
  font-weight: bold;
  margin-top: 6px;
}

.empty-box {
  width: 200px;
  padding: 24px 8px;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  color: #FFFFFF;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  lines: -1;
}

.empty-desc {
  width: 184px;
  color: #888888;
  font-size: 24px;
  line-height: 30px;
  margin-top: 10px;
  text-align: center;
  lines: -1;
}
</style>