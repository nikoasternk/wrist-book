<template>
  <div class="shelf-page">
    <scroll class="main-scroll" scroll-y="true">
      <div class="edge-spacer"></div>

      <text class="app-title">{{strings.appName}}</text>

      <div class="settings-btn" @click="openSettings">
        <text class="settings-btn-txt">{{strings.settings}}</text>
      </div>

      <div class="book-card" for="{{bookList}}">
        <div class="book-open-zone" @click="openBook($item)">
          <text class="book-title">{{$item.name}}</text>
        </div>

        <div class="book-bottom-row">
          <div class="percent-zone" @click="openBook($item)">
            <text class="book-sub">{{$item.percent}}%</text>
          </div>

          <div class="del-btn" @click="onDeleteTap($item)">
            <text class="del-btn-txt">{{confirmDeleteName === $item.name ? strings.confirmDelete : strings.deleteBook}}</text>
          </div>
        </div>
      </div>

      <div class="empty-box" if="{{bookList.length === 0}}">
        <text class="empty-title">{{strings.emptyTitle}}</text>
        <text class="empty-desc">{{strings.emptySubtitle}}</text>
      </div>

      <div class="edge-spacer-bottom"></div>
    </scroll>
  </div>
</template>

<script>
import file from '@system.file'
import storage from '@system.storage'
import brightness from '@system.brightness'
import router from '@system.router'
import { getStrings } from '../../services/Localization'

const BOOKS_DIRECTORY = 'internal://files/books/';

export default {
  private: {
    strings: getStrings('auto'),
    bookList: [],
    progressMap: {},
    confirmDeleteName: ''
  },

  onShow() {
    this.confirmDeleteName = '';
    this.loadConfiguration();
    this.loadBooks();
  },

  loadConfiguration() {
    storage.get({
      key: 'WRISTBOOK_CONFIG',
      success: (data) => {
        let stayAwake = true;
        let lang = 'auto';
        if (data) {
          const cfg = JSON.parse(data);
          stayAwake = cfg.stayAwake !== undefined ? cfg.stayAwake : true;
          lang = cfg.language || 'auto';
          if (cfg.customBrightness) {
            const hwVal = Math.max(10, Math.min(255, Math.round((cfg.brightnessPct || 50) * 2.55)));
            brightness.setMode({ mode: 0 });
            brightness.setValue({ value: hwVal });
          } else {
            brightness.setMode({ mode: 1 });
          }
        }
        this.strings = getStrings(lang);
        brightness.setKeepScreenOn({ keepScreenOn: stayAwake });
      },
      fail: () => {
        brightness.setMode({ mode: 1 });
        this.strings = getStrings('auto');
        brightness.setKeepScreenOn({ keepScreenOn: true });
      }
    });
  },

  loadBooks() {
    storage.get({
      key: 'WRISTBOOK_PROGRESS',
      success: (data) => {
        this.progressMap = data ? JSON.parse(data) : {};
        this.scanDirectory();
      },
      fail: () => {
        this.progressMap = {};
        this.scanDirectory();
      }
    });
  },

  scanDirectory() {
    file.list({
      uri: BOOKS_DIRECTORY,
      success: (data) => {
        if (data && data.fileList) {
          this.bookList = data.fileList
            .filter(item => item.type === 'file')
            .map(item => {
              const displayName = item.uri.split('/').pop().replace(/\.txt$/i, '');
              const saved = this.progressMap[displayName] || { percent: 0 };
              return {
                uri: item.uri,
                name: displayName,
                percent: saved.percent || 0
              };
            });
        } else {
          this.bookList = [];
        }
      },
      fail: () => {
        this.bookList = [];
      }
    });
  },

  onDeleteTap(item) {
    if (this.confirmDeleteName !== item.name) {
      this.confirmDeleteName = item.name;
      return;
    }
    this.confirmDeleteName = '';
    file.delete({
      uri: item.uri,
      complete: () => {
        if (this.progressMap[item.name]) {
          delete this.progressMap[item.name];
          storage.set({ key: 'WRISTBOOK_PROGRESS', value: JSON.stringify(this.progressMap) });
        }
        this.scanDirectory();
      }
    });
  },

  openBook(item) {
    this.confirmDeleteName = '';
    router.push({ uri: 'pages/reader', params: { uri: item.uri, name: item.name } });
  },

  openSettings() {
    this.confirmDeleteName = '';
    router.push({ uri: 'pages/settings' });
  }
}
</script>

<style>
.shelf-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.main-scroll {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}
.edge-spacer {
  width: 200px;
  height: 36px;
  flex-shrink: 0;
}
.edge-spacer-bottom {
  width: 200px;
  height: 56px;
  flex-shrink: 0;
}
.app-title {
  width: 200px;
  height: 44px;
  flex-shrink: 0;
  color: #FFFFFF;
  font-size: 32px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 12px;
}
.settings-btn {
  width: 200px;
  height: 76px;
  flex-shrink: 0;
  background-color: #222222;
  border-radius: 28px;
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}
.settings-btn-txt {
  color: #FFFFFF;
  font-size: 26px;
  font-weight: bold;
}
.book-card {
  width: 200px;
  height: 154px;
  flex-shrink: 0;
  background-color: #1A1A1A;
  border-radius: 28px;
  padding: 14px 12px;
  margin-bottom: 12px;
  flex-direction: column;
  justify-content: space-between;
}
.book-open-zone {
  width: 176px;
  height: 72px;
  flex-shrink: 0;
  justify-content: flex-start;
}
.book-title {
  width: 176px;
  color: #FFFFFF;
  font-size: 28px;
  line-height: 34px;
  font-weight: bold;
  lines: 2;
  text-overflow: ellipsis;
}
.book-bottom-row {
  width: 176px;
  height: 48px;
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
}
.percent-zone {
  height: 48px;
  justify-content: center;
  align-items: center;
}
.book-sub {
  color: #AAAAAA;
  font-size: 24px;
  font-weight: bold;
}
.del-btn {
  height: 46px;
  padding: 0 14px;
  background-color: #333333;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
}
.del-btn-txt {
  color: #FFFFFF;
  font-size: 22px;
  font-weight: bold;
}
.empty-box {
  width: 200px;
  height: 180px;
  flex-shrink: 0;
  padding: 20px 8px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.empty-title {
  color: #FFFFFF;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
}
.empty-desc {
  width: 184px;
  color: #888888;
  font-size: 24px;
  line-height: 30px;
  margin-top: 10px;
  text-align: center;
  lines: -1;
}
</style>
